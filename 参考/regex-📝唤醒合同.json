    </style>
</head>
<body>

<textarea class="contract-float-text" id="contract-prelude" placeholder="可以在此处输入前置情节(如有)" rows="2"></textarea>
<div class="paper-sheet" style="position:relative;">
    <div class="contract-overlay" id="contract-overlay">
        <div class="contract-loader">
            <div class="c-paper">
                <div class="c-scan-bar"></div>
                <div class="c-line"></div><div class="c-line"></div>
                <div class="c-line short"></div><div class="c-line"></div>
                <div class="c-line short"></div>
            </div>
            <div class="c-magnifier"></div>
            <div class="c-loading-text">合同审阅中...</div>
        </div>
    </div>
    <div class="app-header">主从契约法术卷轴·现代版(系统友情提供)</div>
    <div class="c-title">劳 动 合 同</div>

    <div class="form-row">
        <span class="label">甲方(雇佣方)：</span>
        <input type="text" class="input-line" id="inp-name" placeholder="(请签署姓名)" autocomplete="off">
    </div>

    <div class="form-row">
        <span class="label">乙方(劳动方)：</span>
        <span style="font-family:'KaiTi'; border-bottom:1px solid #ccc; padding:0 80px;">       </span>
    </div>

    <div style="font-weight:bold; font-size:14px; margin-top:10px;">工作内容：</div>
    <textarea class="textarea-line" id="inp-job" placeholder="选填，可自由填写"></textarea>

    <div style="font-weight:bold; font-size:14px; margin-top:10px;">劳动报酬及其它约定：</div>
    <textarea class="textarea-line" id="inp-pay" placeholder="选填，可自由填写"></textarea>

    <div class="info-section">
        <div class="info-toggle" id="toggle-btn">▲ 员工信息录入 (点击展开/收起)</div>
        <div class="info-content" id="info-box">
            <div class="tags-container" id="tags-area">
                </div>
            <div class="other-row">
                <span class="other-label">其它:</span>
                <input type="text" class="other-input" id="inp-other" placeholder="如添加多个属性，用顿号分隔">
            </div>
        </div>
    </div>

    <div class="sign-area">
        <div>
            <div style="font-size:12px; color:#666; margin-bottom:10px;">甲方盖章(完成填写后点此确认)</div>

            <div class="stamp-wrapper">
                <div class="stamp-mark" id="stamp-anim">
                    <div style="font-size:32px; line-height:1;">★</div>
                    <div style="font-size:10px;">承認</div>
                </div>
                <div class="stamp-placeholder" id="stamp-trigger">盖章处</div>
            </div>

        </div>
        <div style="text-align:right;">
            <div style="font-size:12px; color:#666; margin-bottom:20px;">乙方签字/手印</div>
            <div id="sign-preview" style="font-family:'KaiTi'; font-size:24px; min-width:80px; border-bottom:1px solid #000; display:inline-block; height:30px;"></div>
        </div>
    </div>
</div>
<textarea class="contract-float-text" id="contract-epilogue" placeholder="可以在此处输入后置情节(如有)，点击【盖章】继续剧情" rows="2"></textarea>

<script>
    const infoConfig = [
        { label: "姓名", content: "" },
        { label: "刀种", content: "" },
        { label: "职业", content: "" },
        { label: "外貌", content: "发色、瞳色、特质(如有)" },
        { label: "性格", content: "MBTI" },
        { label: "擅长", content: "" },
        { label: "喜好", content: "如口味、偏好行为等" },
        { label: "出身经历", content: "概括简写" },
        { label: "受教育程度", content: "低/中/高" },
        { label: "雇佣经过", content: "概括简写" },
        { label: "工作内容", content: "在万事屋的工作内容，简写" },
        { label: "{{user}}允诺报酬", content: "双方协商的最终结果" }
    ];

    const defaultSelected = ["姓名", "刀种", "外貌", "性格", "职业", "雇佣经过", "出身经历", "{{user}}允诺报酬", "工作内容"];
    let isSigning = false;

    document.querySelectorAll('.contract-float-text').forEach(ta => {
        ta.addEventListener('input', function() {
            this.style.height = 'auto';
            this.style.height = this.scrollHeight + 'px';
        });
    });

    $(document).ready(function() {

        const tagContainer = $('#tags-area');
        infoConfig.forEach((item, index) => {
            const isSelected = defaultSelected.includes(item.label);

            const tag = $('<div></div>')
                .addClass('info-tag')
                .text(item.label)
                .attr('data-content', item.content)
                .attr('data-label', item.label);

            if(isSelected) {
                tag.addClass('selected');
            }

            tag.on('click', function() {
                $(this).toggleClass('selected');
            });

            tagContainer.append(tag);
        });

        $('#toggle-btn').on('click', function() {
            $('#info-box').slideToggle(200);
            const text = $(this).text();
            $(this).text(text.includes('▼') ? text.replace('▼', '▲') : text.replace('▲', '▼'));
        });

        $('#stamp-trigger').on('click', async function() {
            await doSign();
        });
    });

    async function doSign() {
        if (isSigning) return;
        const overlay = document.getElementById('contract-overlay');
        overlay.classList.add('active');

        const name = $('#inp-name').val().trim();
        const job = $('#inp-job').val().trim() || "未定";
        const pay = $('#inp-pay').val().trim() || "未定";

        if (!name) {
            if(window.toastr) toastr.warning("请先签署姓名");
            else alert("请先签署姓名");
            return;
        }

        isSigning = true;

        const stamp = $('#stamp-anim');
        stamp.removeClass('active');
        void stamp[0].offsetWidth;
        stamp.addClass('active');

        await new Promise(resolve => setTimeout(resolve, 500));

        let infoData = [];

        // 1. 收集选中的标签
        $('.info-tag.selected').each(function() {
            const label = $(this).attr('data-label');
            const content = $(this).attr('data-content');
            const val = content ? `(${content})` : "";
            infoData.push(`${label}:${val}`);
        });

        // 2. 收集"其它"输入，按顿号分割
        const otherVal = $('#inp-other').val().trim();
        if(otherVal) {
            const parts = otherVal.split(/[、]/);
            parts.forEach(part => {
                const trimmed = part.trim();
                if (trimmed) {
                    // 修改点：给拆分出的属性末尾加上冒号 ":"
                    infoData.push(trimmed + ":");
                }
            });
        }

        const infoString = infoData.length > 0 ? "【" + infoData.join("|") + "】" : "";

        try {
            const msgs = await getChatMessages(-1);
            if (!msgs || msgs.length === 0) throw new Error("未找到当前楼层");

            const lastMsg = msgs[0];

            const contractContent = `
<合同当前内容>
  劳动合同
    甲方: ${name}
    乙方:
    乙方签名/手印:
    工作内容: ${job}
    劳动报酬及其它约定: ${pay}
</合同当前内容>`;

            const prelude = document.getElementById('contract-prelude').value.trim();
            const epilogue = document.getElementById('contract-epilogue').value.trim();

            // 将合同内容追加到AI旧消息（供渲染合同卡片用）
            await setChatMessages([{
                message_id: lastMsg.message_id,
                message: lastMsg.message + '\n' + contractContent
            }], { refresh: 'none' });

            // 将指令作为用户消息发送（确保AI遵从）
            let userMsg = '';
            if (prelude) userMsg += prelude + '\n\n';
            userMsg += '> [系统事件] 合同已签署，等待乙方确认。';
            if (epilogue) userMsg += '\n\n' + epilogue;
            userMsg += '\n<sys>以上合同内容已附在上条消息中。在本轮正文中：①将双方最终协商补充完整的合同内容按<合同当前内容>格式插入正文合适位置（如原内容有改变可删改，员工可主动提出诉求）②插入关于雇佣该员工的成就弹窗③在<yorozuya_status>前输出<New_Employee_Profile>【' + infoString.slice(1,-1) + '】</New_Employee_Profile>，使用概括性语言记录长期不变的角色设定</sys>';

            if(window.toastr) toastr.success("甲方填写完毕，等待回应...");

            // 通过输入框发送用户消息并自动触发AI回复
            var sent = false;
            try {
                var box = window.parent.document.getElementById('send_textarea');
                if (box) { box.value = userMsg; box.dispatchEvent(new Event('input',{bubbles:true})); box.focus(); var btn = window.parent.document.getElementById('send_but'); if(btn) setTimeout(function(){btn.click();},300); sent = true; }
            } catch(e) {}
            if (!sent) { try { var box2 = document.getElementById('send_textarea'); if (box2) { box2.value = userMsg; box2.dispatchEvent(new Event('input',{bubbles:true})); box2.focus(); var btn2 = document.getElementById('send_but'); if(btn2) setTimeout(function(){btn2.click();},300); sent = true; } } catch(e2) {} }
            if (!sent) { await triggerSlash('/trigger'); }

        } catch (e) {
            overlay.classList.remove('active');
            console.error(e);
            isSigning = false;
            alert("环境调用失败，请检查是否安装了 JS Slash Runner 插件。\n错误信息: " + e.message);
        }
    }
</script>

</body>
</html>
