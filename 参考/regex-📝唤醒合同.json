        .stamp-mark.active { animation: stampFall 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards; }
        @keyframes stampFall { 0% { transform: rotate(-20deg) scale(2.5); opacity: 0; } 100% { transform: rotate(-20deg) scale(1); opacity: 0.9; } }

        .info-section {
            margin-top: 30px;
            border-top: 1px dashed #ccc;
