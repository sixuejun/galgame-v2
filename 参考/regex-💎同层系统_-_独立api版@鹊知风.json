            } else {
                console.warn("⚠️ 获取到了 MVU 数据，但 stat_data 为空。尝试使用全局变量...");
                // 双重保险：如果 message 里没有，试着找 chat 类型的
                const chatData = parentWin.Mvu.getMvuData({ type: 'chat' });
