</div>

<script>
    // ================= 独立 API 配置与拦截器 =================
    let customApiConfig = {
        enabled: false,
        url: "https://api.deepseek.com/v1",
        key: "",
        model: "deepseek-chat"
    };

    function loadApiConfig() {
        try {
            const saved = localStorage.getItem('tavern_sys_api');
            if(saved) customApiConfig = { ...customApiConfig, ...JSON.parse(saved) };
        } catch(e) {}
    }
    loadApiConfig();

    function showApiSettings() {
        document.getElementById('api-url').value = customApiConfig.url;
        document.getElementById('api-key').value = customApiConfig.key;
        document.getElementById('api-model').value = customApiConfig.model;
        document.getElementById('api-enabled').checked = customApiConfig.enabled;
        document.getElementById('api-mask').style.display = 'flex';
    }

    function closeApiSettings() { document.getElementById('api-mask').style.display = 'none'; }

    function saveApiSettings() {
        customApiConfig.url = document.getElementById('api-url').value.trim();
        customApiConfig.key = document.getElementById('api-key').value.trim();
        customApiConfig.model = document.getElementById('api-model').value.trim();
        customApiConfig.enabled = document.getElementById('api-enabled').checked;
        localStorage.setItem('tavern_sys_api', JSON.stringify(customApiConfig));
        closeApiSettings();
        alert("独立 API 设置已保存！");
    }

    async function testApiConnection(btn) {
        const url = document.getElementById('api-url').value.trim();
        const key = document.getElementById('api-key').value.trim();
        if (!url) { alert("请先填写接口地址 (Base URL) ！"); return; }

        const originalText = btn.innerText;
        btn.innerText = "测试中...";
        btn.disabled = true;

        try {
            let endpoint = url.replace(/\/+$/, '') + '/models';
            const headers = {};
            if (key) headers['Authorization'] = `Bearer ${key}`;

            const res = await fetch(endpoint, { method: 'GET', headers });
            if (res.ok) {
                alert("✅ 连接成功！API 地址有效。");
            } else {
                alert(`❌ 连接失败: 状态码 ${res.status}`);
            }
        } catch (e) {
            alert(`❌ 连接出错: ${e.message}\n(请检查地址是否填写正确，或您的 API 服务是否存在跨域限制)`);
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    async function fetchModels(btn) {
        const url = document.getElementById('api-url').value.trim();
        const key = document.getElementById('api-key').value.trim();
        if (!url) { alert("请先填写接口地址 (Base URL) 才能拉取哦！"); return; }

        const originalText = btn.innerText;
        btn.innerText = "拉取中...";
        btn.disabled = true;

        try {
            let endpoint = url.replace(/\/+$/, '') + '/models';
            const headers = {};
            if (key) headers['Authorization'] = `Bearer ${key}`;

            const res = await fetch(endpoint, { method: 'GET', headers });

            if (!res.ok) throw new Error(`状态码 ${res.status}`);

            const data = await res.json();
            if (data && data.data && Array.isArray(data.data)) {
                const dataList = document.getElementById('model-list');
                dataList.innerHTML = '';
                data.data.forEach(m => {
                    const opt = document.createElement('option');
                    opt.value = m.id;
                    dataList.appendChild(opt);
                });
                alert(`✅ 成功拉取 ${data.data.length} 个模型！\n现在您可以点击“模型名称”输入框，在下拉列表中进行选择。`);
            } else {
                throw new Error("返回的数据格式不包含模型列表");
            }
        } catch (e) {
            alert(`❌ 拉取模型失败: ${e.message}`);
        } finally {
            btn.innerText = originalText;
            btn.disabled = false;
        }
    }

    async function smartGenerate(reqOptions) {
        if (customApiConfig.enabled && customApiConfig.url) {
            let sysPrompt = "";
            if (reqOptions.ordered_prompts) {
                const sysObj = reqOptions.ordered_prompts.find(p => typeof p === 'object' && p.role === 'system');
                if (sysObj) sysPrompt = sysObj.content;
            }

            let endpoint = customApiConfig.url.replace(/\/+$/, '');
            if (!endpoint.endsWith('/chat/completions')) {
                endpoint += '/chat/completions';
            }

            const payload = {
                model: customApiConfig.model,
                messages: [
                    { role: "system", content: sysPrompt },
                    { role: "user", content: reqOptions.user_input || " " }
                ],
                temperature: 0.7
            };

            const headers = { "Content-Type": "application/json" };
            if (customApiConfig.key) headers["Authorization"] = `Bearer ${customApiConfig.key}`;

            const response = await fetch(endpoint, {
                method: "POST",
                headers: headers,
                body: JSON.stringify(payload)
            });

            if (!response.ok) {
                const errText = await response.text();
                console.error("独立 API 报错:", errText);
                throw new Error(`API 请求失败: ${response.status}`);
            }

            const data = await response.json();
            return data.choices[0].message.content;
        } else {
            return await generateRaw(reqOptions);
        }
    }

