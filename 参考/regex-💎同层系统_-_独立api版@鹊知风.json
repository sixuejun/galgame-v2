            return;
        }

        if (confirm(`确认花费 20000 小判将万事屋跳跃至「${location}」吗？\n\n跳跃后万事屋将立即出现在该地点，此操作无法撤销。`)) {
            executeJump(location);
            input.value = '';
        }
    }

    async function executeJump(location) {
        setLoading(true, "空间跳跃中...");

        try {
            const prompt = `[System]{{user}}消费20000小判，使用系统的空间跳跃功能，将万事屋转移到了${location}。现在请继续角色扮演，描述万事屋突然出现在${location}后的情景。请自然地描述周围环境、当地特色、以及可能发生的事件，让剧情自然过渡到新地点。`;

            const res = await smartGenerate({
                user_input: " ",
                ordered_prompts: ['world_info', 'char_description', 'chat_history', {role:'system', content:prompt}],
                quiet: true
            });

            await createChatMessages([{
                role: 'assistant',
                message: res.trim()
            }]);

            setLoading(false);
            goHome();

            alert(`✨ 空间跳跃成功！\n万事屋已转移至「${location}」\n新的剧情已展开，请查看聊天记录。`);

        } catch(e) {
            setLoading(false);
            alert("空间跳跃失败，请稍后重试");
            console.error(e);
        }
    }

    // ================= 通用注入 =================
    function injectInput(txt, autoSend=false) {
        try {
            const box = window.parent.document.getElementById('send_textarea');
            if(box) {
                const prev = box.value;
                box.value = prev ? prev + "\n" + txt : txt;
                box.dispatchEvent(new Event('input', {bubbles:true})); box.focus();
                if(autoSend) setTimeout(()=>{ const btn=window.parent.document.getElementById('send_but'); if(btn) btn.click(); }, 200);
            }
        } catch(e) { console.error(e); }
    }
</script>
</body>
</html>
