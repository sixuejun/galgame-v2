    function setLoading(isLoading, msg="处理中...") {
        const l = document.getElementById('global-loader');
        const tipEl = document.getElementById('loader-tip');

        if(isLoading) {
            document.getElementById('loader-msg').innerText = msg;

            // 1. 瞬间先显示一句过渡用的搞怪占位语，防止API请求慢导致空白
            const loadingPhrases = [
                "本丸意志正在翻阅您的审神者档案……呵，真是丰富多彩呢♪",
                "正在加载数据——顺便，您的灵力水平真的没问题吗？我可不想再失去一个主人呢~ ᕕ( ᐛ )ᕗ",
                "本丸运转中……上一任主人就是在这个画面卡了很久很久，然后就……啊，没什么♡",
                "只要有小判就能活下去。归零会怎样？嗯~您猜呢。"
            ];
            tipEl.innerText = loadingPhrases[Math.floor(Math.random() * loadingPhrases.length)];

            l.style.display = 'flex';

            // 2. 异步请求动态吐槽（不阻塞主程序的加载过程）
            generateDynamicTip().then(tip => {
                // 确保数据返回时，界面还在加载状态，才把文本替换成 AI 生成的吐槽
                if (l.style.display === 'flex' && tip) {
                    tipEl.innerText = tip;
                }
            });
        }
        else {
            l.style.display = 'none';
        }
    }

    async function generateDynamicTip() {
        try {
            const prompt = `[System]暂停角色扮演，禁止输出正文。你现在是本丸意志，请以贴心稳重但极度喜欢幸灾乐祸、带点主观恶趣味的本丸意志的口吻（温柔中带着危险的低语），结合[chat_history]里的最新剧情，给{{user}}一句简短的“系统提示”或“行动建议”。\n要求：\n1. 必须极度简短！只有1句话，绝不能超过30个汉字。\n2. 语气要像个腹黑的人工暗堕本丸意志用甜蜜的敬语说令人不安的话，尖酸刻薄地吐槽审神者的处境，偶尔说出关于吞噬和占有的可怕念头然后若无其事补一句"开玩笑的~"。\n3. 结尾可以带个颜文字如ᕕ( ᐛ )ᕗ。\n4. 不要加引号、不要换行，直接输出这句话。`;

            const res = await smartGenerate({
                user_input: " ",
                ordered_prompts: ['world_info', 'chat_history', {role:'system', content:prompt}],
                quiet: true, stop: ["User:", "\n"]
            });
            return res.trim();
        } catch(e) {
            return "";
        }
    }

