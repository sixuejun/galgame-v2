```
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <style>
        /* ================= 1. 全局基础 ================= */
        :root {
            --p: #C73E3A; --bg: #f5edd8; --txt: #3a2c1f; --gry: #8a7a6a;
            --blue: #4a6478; --green: #5d7a5d; --purple: #6b4c2a;
        }
        body {
            margin: 0;
            font-family: 'Noto Sans SC', 'Varela Round', 'Nunito', sans-serif;
            overflow: hidden; background: transparent;
        }

        #app-root {
            width: 100%; height: 500px; max-width: 500px;
            position: relative; overflow: hidden;
            border-radius: 24px;
            background: #fff;
        }

        /* 页面切换逻辑 */
        .page-view {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            display: none; flex-direction: column; overflow: hidden; background: #fff;
            animation: fadeIn 0.3s ease-out;
        }
        .page-view.active { display: flex; }
        @keyframes fadeIn { from { opacity: 0; transform: scale(0.98); } to { opacity: 1; transform: scale(1); } }

        /* 公共头部 & 按钮 */
        .app-header {
            padding: 10px 15px; display: flex; align-items: center; gap: 10px; color: #fff;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1); z-index: 10; flex-shrink: 0;
            position: relative;
        }
        .btn-back { background: transparent; border: none; color: #fff; font-size: 18px; cursor: pointer; font-weight: bold; z-index: 2; position: relative; }

        /* 修改点③：标题绝对居中，不受左右元素影响 */
        .header-title {
            font-weight: bold; font-size: 14px;
            position: absolute; left: 0; width: 100%; text-align: center;
            pointer-events: none; z-index: 1;
        }

        .header-actions { display: flex; gap: 8px; align-items: center; position: absolute; right: 15px; z-index: 2; }
        .btn-mini-icon {
            width: 24px; height: 24px; border-radius: 50%; border: 1px solid rgba(255,255,255,0.5);
            background: rgba(0,0,0,0.1); color: #fff; font-size: 12px; cursor: pointer;
            display: flex; align-items: center; justify-content: center; backdrop-filter: blur(2px);
        }
        .btn-mini-icon:hover { background: rgba(255,255,255,0.2); }

        /* 余额显示胶囊 */
        .balance-pill {
            background: rgba(0,0,0,0.3); padding: 4px 10px; border-radius: 12px;
            font-size: 11px; font-weight: bold; display: flex; align-items: center; gap: 4px;
            border: 1px solid rgba(255,255,255,0.2);
            /* 修改点：配合标题绝对定位，将余额条自动推到右侧 */
            margin-left: auto;
            z-index: 2; position: relative;
        }

        /* 加载层 */
        .loader-mask { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(255,255,255,0.85); z-index: 50; display: none; flex-direction: column; align-items: center; justify-content: center; }
        .spinner { width: 32px; height: 32px; border: 3px solid #ffdcb9; border-top-color: var(--p); border-radius: 50%; animation: spin 0.8s linear infinite; margin-bottom: 8px; }
        .load-text { font-size: 12px; color: var(--p); font-weight: bold; }
        /* 修改点④：小科普样式 */
        .loader-tip { margin-top: 15px; font-size: 12px; color: #888; text-align: center; max-width: 80%; line-height: 1.5; font-weight: normal; opacity: 0.9; }

        @keyframes spin { 100% { transform: rotate(360deg); } }

        /* 说明书弹窗 */
        .help-mask {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.6); backdrop-filter: blur(3px); z-index: 60;
            display: none; align-items: center; justify-content: center;
            animation: fadeIn 0.2s;
        }
        .help-modal {
            width: 80%; max-height: 70%; background: #fff; border-radius: 16px;
            padding: 20px; display: flex; flex-direction: column;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
            animation: popIn 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        }
        .help-title { font-size: 16px; font-weight: bold; margin-bottom: 10px; color: #333; border-bottom: 2px solid #eee; padding-bottom: 5px; }
        .help-content { font-size: 13px; color: #555; line-height: 1.6; overflow-y: auto; flex: 1; white-space: pre-wrap; }
        .help-close { margin-top: 15px; background: var(--p); color: #fff; border: none; padding: 8px 0; border-radius: 20px; font-weight: bold; cursor: pointer; }

        /* ================= 2. 首页样式 ================= */
        #page-home {
            background: #f5edd8;
            border-top: 8px solid #6b4c2a; border-bottom: 8px solid #6b4c2a; border-left: none; border-right: none; box-sizing: border-box; position: relative;
        }
        .top-deco {
            position: relative; text-align: center; margin-top: 15px; margin-bottom: 5px;
            font-size: 24px; font-family: 'Shippori Mincho', 'Noto Serif SC', serif; font-weight: 900;
            color: #fff; font-style: normal; z-index: 20; transform: rotate(0deg);
            text-shadow: -2px -2px 0 #6b4c2a, 2px -2px 0 #6b4c2a, -2px 2px 0 #6b4c2a, 2px 2px 0 #6b4c2a, 0 4px 5px rgba(0,0,0,0.15);
            animation: logoDrop 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
        }
        @keyframes logoDrop { 0% { transform: translateY(-30px) rotate(-3deg); opacity: 0; } 100% { transform: translateY(0) rotate(-3deg); opacity: 1; } }

        .bg-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
        .sticker-entrance { animation: stickerFadeIn 1.2s ease-out backwards; width: 100%; height: 100%; }
        @keyframes stickerFadeIn { from { opacity: 0; } to { opacity: 1; } }

        .sticker-img { user-select: none; pointer-events: none; }
        .float-item { display: none !important; }
        @keyframes floatAround {
            0% { transform: translate(0, 0) rotate(-5deg); }
            50% { transform: translate(0, -15px) rotate(5deg); }
            100% { transform: translate(0, 0) rotate(-5deg); }
        }

        .hero-zone { flex: 0; display: none; }
        .hero-wrapper { animation: heroPop 0.8s cubic-bezier(0.175, 0.885, 0.32, 1.275) backwards; animation-delay: 0.2s; }
        .hero-sticker { display: none !important; }
        @keyframes heroPop { 0% { transform: scale(0.5); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
        @keyframes breathe { 0%, 100% { transform: scale(1) rotate(0deg); } 50% { transform: scale(1.05) rotate(2deg); } }

        .dock-bar { position: relative; z-index: 10; padding: 0 20px 25px 20px; display: flex; flex-direction: column; gap: 12px; flex: 1; justify-content: center; }
        .btn-row { display: flex; gap: 12px; width: 100%; animation: slideUp 0.6s cubic-bezier(0.25, 0.8, 0.25, 1) backwards; }
        .row-1 { animation-delay: 0.3s; } .row-2 { animation-delay: 0.4s; }
        @keyframes slideUp { 0% { transform: translateY(40px); opacity: 0; } 100% { transform: translateY(0); opacity: 1; } }

        .cream-btn {
            flex: 1; background: #f5edd8; border: 2px solid #d4c5a9; border-radius: 0; padding: 12px 0; cursor: pointer;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            box-shadow: 0 2px 6px rgba(60,50,40,0.1); transition: all 0.1s; position: relative;
        }
        .cream-btn:active { transform: translateY(4px); box-shadow: 0 0 0 #e6dcc5; }
        .btn-icon { font-size: 20px; margin-bottom: 4px; }
        .btn-txt { font-size: 12px; font-weight: 800; color: #6d665a; letter-spacing: 1px; }

        /* ================= 3. 商城样式 ================= */
        #page-mall { background: var(--bg); position: relative; }
        #page-mall .app-header { background: linear-gradient(90deg, #C73E3A, #a52a2a); padding: 8px 12px; }

        .mall-search-box { flex: 1; background: #fff; border-radius: 18px; height: 30px; display: flex; align-items: center; padding: 0 10px; }
        #keyword-inp { border: none; outline: none; width: 100%; font-size: 12px; color: #333; background: transparent; }
        #keyword-inp::placeholder { color: #ccc; }
        .mall-go { background: #fff; color: var(--p); border: none; border-radius: 16px; padding: 0 12px; height: 28px; font-size: 12px; font-weight: bold; cursor: pointer; margin-left: 8px; transition: 0.2s; }

        .nav-bar { background: #fff; display: flex; align-items: center; justify-content: space-between; padding: 8px 15px; font-size: 12px; color: var(--txt); box-shadow: 0 2px 5px rgba(0,0,0,0.03); z-index: 1; flex-shrink: 0; }
        .nav-left { display: flex; gap: 20px; }
        .nav-item.active { color: var(--p); font-weight: bold; position: relative; }
        .nav-item.active::after { content: ''; position: absolute; bottom: -8px; left: 50%; transform: translateX(-50%); width: 10px; height: 2px; background: var(--p); border-radius: 2px; }

        .list-zone { flex: 1; overflow-y: auto; padding: 10px; padding-bottom: 15px; display: flex; flex-direction: column; gap: 10px; transition: padding-bottom 0.3s; }
        .list-zone.has-cart { padding-bottom: 70px; }

        /* 商品卡片 */
        .card { background: #fff; border-radius: 10px; padding: 10px; display: flex; gap: 10px; box-shadow: 0 2px 6px rgba(0,0,0,0.02); transition: all 0.2s; }
        .c-img { width: 80px; height: 80px; background: #f9f9f9; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-size: 35px; flex-shrink: 0; }
        .c-img img.emoji { width: 48px !important; height: 48px !important; }
        .c-info { flex: 1; display: flex; flex-direction: column; justify-content: space-between; }
        .c-title-row { line-height: 1.4; color: var(--txt); }
        .c-title-txt { font-weight: bold; font-size: 15px; }
        .pro-tag { display: inline-block; background: linear-gradient(90deg, #C73E3A, #a52a2a); color: #fff; font-size: 10px; padding: 0 4px; border-radius: 3px; margin-right: 4px; font-weight: bold; vertical-align: text-bottom; height: 16px; line-height: 16px; }
        .c-desc { font-size: 11px; color: #999; margin-top: 4px; line-height: 1.4; white-space: normal; }
        .c-foot { display: flex; justify-content: space-between; align-items: flex-end; margin-top: 8px; }
        .c-price { color: #C73E3A; font-size: 16px; font-weight: 900; }
        .c-sales { font-size: 10px; color: #bbb; margin-left: 4px; }

        .btn-buy { background: #ffebd7; color: var(--p); border: 1px solid var(--p); border-radius: 14px; padding: 4px 12px; font-size: 11px; cursor: pointer; font-weight: bold; transition: 0.2s; }

        /* 数量控制器 */
        .qty-control { display: none; align-items: center; background: #fff; border: 1px solid #ddd; border-radius: 14px; height: 24px; }
        .qty-control.active { display: flex; }
        .qty-btn { width: 24px; height: 100%; border: none; background: transparent; color: var(--txt); font-weight: bold; cursor: pointer; font-size: 14px; }
        .qty-num { width: 30px; text-align: center; font-size: 12px; font-weight: bold; color: var(--txt); }

        /* 购物车栏 */
        .cart-bar {
            position: absolute; bottom: 15px; left: 15px; right: 15px;
            background: rgba(0,0,0,0.9); backdrop-filter: blur(8px);
            border-radius: 40px; height: 50px; padding: 0 5px 0 20px;
            display: flex; align-items: center; justify-content: space-between;
            color: #fff; box-shadow: 0 5px 20px rgba(0,0,0,0.25);
            transform: translateY(150%); transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            z-index: 30;
        }
        .cart-bar.show { transform: translateY(0); }
        .cart-total-hl { color: #C73E3A; font-size: 18px; font-weight: 900; margin-left: 5px; }

        .cart-toggle-btn { background: transparent; border: none; color: #ccc; font-size: 12px; cursor: pointer; padding: 5px 10px; }

        .btn-checkout {
            background: linear-gradient(90deg, #C73E3A, #a52a2a); border: none;
            color: #fff; border-radius: 20px; padding: 0 20px; height: 40px;
            font-weight: bold; cursor: pointer; font-size: 13px; margin-right: 2px;
            box-shadow: 0 2px 10px rgba(255, 80, 0, 0.3);
        }

        /* 购物车抽屉 */
        .cart-drawer-mask {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5); z-index: 25;
            display: none; opacity: 0; transition: opacity 0.3s;
        }
        .cart-drawer-mask.open { display: block; opacity: 1; }

        .cart-drawer {
            position: absolute; bottom: 0; left: 0; width: 100%;
            background: #fff; border-radius: 24px 24px 0 0;
            padding: 20px 20px 80px 20px; box-sizing: border-box;
            transform: translateY(100%); transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            z-index: 26; max-height: 70%; display: flex; flex-direction: column;
        }
        .cart-drawer.open { transform: translateY(0); }

        .drawer-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 10px; }
        .drawer-title { font-weight: bold; font-size: 14px; color: #333; }
        .drawer-clear { color: #999; font-size: 12px; cursor: pointer; }
        .drawer-list { overflow-y: auto; flex: 1; }

        .drawer-item { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f5f5f5; }
        .d-name { font-size: 13px; font-weight: bold; color: #333; }
        .d-price { font-size: 12px; color: #C73E3A; margin-left: 5px; }

        .end-tip { text-align: center; color: #ccc; font-size: 11px; margin-top: 10px; margin-bottom: 5px; display: flex; align-items: center; justify-content: center; gap: 5px; }
        .end-tip::before, .end-tip::after { content: ''; display: block; width: 20px; height: 1px; background: #e0e0e0; }

        /* ================= 4. 本丸管家 (左右切换版样式) ================= */
        #page-butler { background: #f0f4f8; }
        #page-butler .app-header { background: linear-gradient(90deg, #5d7a5d, #7a9a7a); }

        .butler-dash { padding: 15px; overflow-y: auto; flex: 1; display: flex; flex-direction: column; }

        .scan-zone {
            background: #fff; border-radius: 12px; padding: 15px; margin-bottom: 15px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05); text-align: center; flex-shrink: 0;
        }

        .butler-action-grid {
            display: grid; grid-template-columns: 1fr 1fr; gap: 10px;
        }

        .btn-action-tile {
            background: #f8f9fa; border: 2px solid #eee; border-radius: 12px; padding: 15px 5px;
            display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer;
            transition: all 0.2s; position: relative; overflow: hidden;
        }
        .btn-action-tile:hover { border-color: #28a745; background: #f0fff4; }
        .btn-action-tile:active { transform: scale(0.98); }

        .action-icon { font-size: 28px; }
        .action-label { font-size: 12px; font-weight: bold; color: #555; }

        .btn-action-tile.locked { opacity: 0.6; cursor: not-allowed; background: #eee; }
        .btn-action-tile.locked:hover { border-color: #eee; background: #eee; }
        .lock-overlay {
            position: absolute; top:0; left:0; width:100%; height:100%;
            background: rgba(255,255,255,0.5); display: flex; align-items: center; justify-content: center;
            font-size: 24px; color: #666;
        }

        /* 新版修缮卡片样式 */
        #repair-container { display: none; padding-bottom: 20px; }
        #repair-container.active { display: block; animation: slideUp 0.4s ease-out; }

        .repair-card {
            background: #fff; border-radius: 12px; padding: 15px; margin-bottom: 15px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05); transition: 0.2s; border: 2px solid transparent;
        }
        .repair-card.active-selection { border-color: #28a745; background: #f0fff4; }

        .rc-head { font-weight: bold; color: #333; font-size: 14px; margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center; }
        .rc-idx { background: #eee; color: #666; font-size: 10px; padding: 2px 6px; border-radius: 4px; margin-right: 6px; }

        .rc-slider {
            display: flex; align-items: center; justify-content: space-between;
            background: #f8f9fa; border-radius: 8px; padding: 5px; margin-bottom: 10px;
        }
        .rc-arrow {
            width: 32px; height: 32px; border: none; background: transparent;
            font-weight: bold; color: #999; cursor: pointer; font-size: 16px; display: flex; align-items: center; justify-content: center;
        }
        .rc-arrow:hover { color: #333; background: rgba(0,0,0,0.05); border-radius: 6px; }
        .rc-price { font-weight: 900; font-size: 18px; color: var(--p); }

        .rc-desc {
            font-size: 13px; color: #555; line-height: 1.6; margin-bottom: 15px;
            min-height: 40px;
        }

        .rc-btn-select {
            width: 100%; padding: 10px 0; border: 1px solid #28a745;
            background: #fff; color: #28a745; border-radius: 20px;
            cursor: pointer; font-weight: bold; transition: 0.2s; font-size: 13px;
        }
        .rc-btn-select:hover { background: #e9f7ef; }
        .rc-btn-select.selected { background: #28a745; color: #fff; border-color: #28a745; }

        .butler-foot { padding: 15px; background: #fff; border-top: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; display: none; }
        .butler-foot.active { display: flex; }
        .total-invest { font-size: 14px; font-weight: bold; color: #333; }
        .btn-invest { background: #28a745; color: #fff; border: none; padding: 8px 20px; border-radius: 20px; font-weight: bold; cursor: pointer; }
        .btn-invest:disabled { background: #ccc; cursor: not-allowed; }

        /* ================= 5. 福引所 ================= */
        #page-luck { background: #1e1c18; color: #fff; }
        #page-luck .app-header { background: transparent; position: absolute; top: 0; width: 100%; box-sizing: border-box; }

        .luck-bg { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at 50% 30%, #3a2c1f 0%, #1e1c18 70%); z-index: 0; }
        .pool-visual { position: relative; z-index: 5; flex: 1; display: flex; align-items: center; justify-content: center; flex-direction: column; }
        .pool-circle { width: 180px; height: 180px; border-radius: 50%; background: url('https://files.catbox.moe/5m9y3o.png') no-repeat center/cover; box-shadow: 0 0 30px rgba(199, 62, 58, 0.3); animation: pulsePool 3s infinite ease-in-out; border: 4px solid rgba(196,154,42,0.4); display: flex; align-items: center; justify-content: center; font-size: 40px; }
        @keyframes pulsePool { 0%,100%{box-shadow:0 0 30px rgba(199,62,58,0.3)} 50%{box-shadow:0 0 50px rgba(199,62,58,0.5)} }

        .gacha-btns { position: relative; z-index: 10; padding: 30px 20px; display: flex; gap: 15px; justify-content: center; }
        .btn-draw { flex: 1; padding: 15px 0; border: 2px solid #d4c5a9; border-radius: 12px; background: rgba(58, 44, 31, 0.7); color: #fff; cursor: pointer; display: flex; flex-direction: column; align-items: center; gap: 5px; transition: 0.1s; backdrop-filter: blur(5px); }
        .btn-draw:active { transform: scale(0.96); background: rgba(107, 76, 42, 0.3); }
        .draw-title { font-size: 16px; font-weight: bold; color: #f5edd8; }
        .draw-cost { font-size: 12px; color: #bbb; }

        /* 结果展示层 */
        .result-layer { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.92); z-index: 50; display: none; flex-direction: column; align-items: center; justify-content: center; animation: fadeIn 0.2s; }
        .item-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; max-height: 380px; overflow-y: auto; padding: 20px; width: 80%; }

        /* === 发光的快递盒子 === */
        .loot-box {
            position: relative;
            background: #2a2520;
            border: 2px solid;
            border-radius: 12px;
            padding: 10px;
            text-align: center;
            display: flex; flex-direction: column; align-items: center; justify-content: center;
            height: 90px;
            animation: popIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) backwards;
            box-shadow: 0 0 10px rgba(255,255,255,0.1);
        }

        /* 品质：R (蓝光) */
        .q-r {
            border-color: #6b8a9a; color: #6b8a9a;
            box-shadow: 0 0 20px rgba(107, 138, 154, 0.6), inset 0 0 10px rgba(107, 138, 154, 0.2);
        }
        /* 品质：SR (紫光) */
        .q-sr {
            border-color: #C73E3A; color: #C73E3A;
            box-shadow: 0 0 25px rgba(199, 62, 58, 0.7), inset 0 0 15px rgba(199, 62, 58, 0.3);
        }
        /* 品质：SSR (金光爆闪) */
        .q-ssr {
            border-color: #ffd700; color: #ffd700;
            background: linear-gradient(135deg, #2a2520 0%, #3a2c1f 100%);
            box-shadow: 0 0 35px rgba(255, 215, 0, 0.9), 0 0 10px rgba(255,255,255,0.8);
            animation: popIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) backwards, pulseGold 1.5s infinite;
        }

        @keyframes pulseGold { 0%,100%{ border-color:#ffd700; } 50%{ border-color:#fff; } }

        .box-icon { font-size: 32px; margin-bottom: 5px; text-shadow: 0 2px 5px rgba(0,0,0,0.5); }
        .box-text { font-size: 14px; font-weight: 900; letter-spacing: 1px; }

        @keyframes popIn {
            0% { transform: scale(0) translateY(20px); opacity: 0; }
            100% { transform: scale(1) translateY(0); opacity: 1; }
        }

        .btn-confirm-draw { margin-top: 25px; padding: 10px 40px; background: #6b4c2a; border: none; color: #fff; border-radius: 25px; cursor: pointer; font-weight:bold; font-size:14px; box-shadow: 0 4px 15px rgba(107, 76, 42, 0.3); }

        /* ================= 6. 本丸意志的低语 ================= */
        #page-chat { background: #f0f2f5; }
        #page-chat .app-header { background: linear-gradient(90deg, #3a2c1f, #5d4037); }
        .chat-area { flex: 1; overflow-y: auto; padding: 15px; display: flex; flex-direction: column; gap: 12px; }
        .bubble { max-width: 80%; padding: 10px 14px; border-radius: 12px; font-size: 13px; line-height: 1.4; word-wrap: break-word; }
        .bubble.ai { align-self: flex-start; background: #fff; color: #333; border-top-left-radius: 2px; }
        .bubble.user { align-self: flex-end; background: #007bff; color: #fff; border-top-right-radius: 2px; }
        .chat-input { background: #fff; padding: 10px; display: flex; gap: 10px; border-top: 1px solid #eee; }
        #chat-inp { flex: 1; border: 1px solid #ddd; border-radius: 20px; padding: 8px 15px; outline: none; font-size: 13px; }
        .chat-send { background: #007bff; color: #fff; border: none; width: 36px; height: 36px; border-radius: 50%; cursor: pointer; display: flex; align-items: center; justify-content: center; }

        /* ================= 7. 时空跳跃服务 ================= */
        .jump-option-card {
            background: #fff;
            border: 2px solid #e8e8e8;
            border-radius: 12px;
            padding: 15px;
            cursor: pointer;
            transition: all 0.2s;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
        }
        .jump-option-card:hover {
            border-color: var(--purple);
            box-shadow: 0 4px 12px rgba(111, 66, 193, 0.15);
            transform: translateY(-2px);
        }
        .jump-option-card:active {
            transform: translateY(0);
        }
        .btn-custom-jump {
            width: 100%;
            margin-top: 10px;
            padding: 10px 0;
            background: linear-gradient(135deg, var(--purple), #8b6c4a);
            color: #fff;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            transition: 0.2s;
        }
        .btn-custom-jump:hover {
            opacity: 0.9;
            transform: scale(1.02);
        }
        .btn-custom-jump:active {
            transform: scale(0.98);
        }

        /* ================= 8. 独立API设置弹窗 ================= */
        .api-mask {
            position: absolute; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 70;
            display: none; align-items: center; justify-content: center;
            animation: fadeIn 0.2s;
        }
        .api-modal {
            width: 85%; background: #fff; border-radius: 16px; padding: 20px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3); display: flex; flex-direction: column; gap: 12px;
        }
        .api-title { font-size: 16px; font-weight: bold; color: #333; border-bottom: 2px solid #eee; padding-bottom: 8px; margin-bottom: 5px; }
        .api-row { display: flex; flex-direction: column; gap: 5px; }
        .api-row label { font-size: 12px; font-weight: bold; color: #555; }
        .api-row input[type="text"], .api-row input[type="password"] {
            padding: 8px 10px; border: 1px solid #ddd; border-radius: 8px; font-size: 12px; outline: none; flex: 1;
        }
        .api-row input:focus { border-color: var(--purple); }
        .api-toggle { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: bold; color: var(--p); cursor: pointer; margin-bottom: 5px;}
        .api-btns { display: flex; gap: 10px; margin-top: 10px; }
        .btn-api-save { flex: 1; background: var(--p); color: #fff; border: none; padding: 10px; border-radius: 20px; font-weight: bold; cursor: pointer; }
        .btn-api-cancel { flex: 1; background: #eee; color: #666; border: none; padding: 10px; border-radius: 20px; font-weight: bold; cursor: pointer; }

        .btn-api-action {
            background: #e9ecef; color: #495057; border: 1px solid #ced4da;
            border-radius: 8px; padding: 0 12px; font-size: 12px; font-weight: bold;
            cursor: pointer; transition: 0.2s; white-space: nowrap; height: 35px;
        }
        .btn-api-action:hover { background: #dee2e6; }
        .btn-api-action:active { transform: scale(0.95); }
        .btn-api-action:disabled { opacity: 0.6; cursor: not-allowed; }

        </style>
<script src="https://cdn.jsdelivr.net/npm/@twemoji/api@15.1.0/dist/twemoji.min.js" crossorigin="anonymous"></script>
