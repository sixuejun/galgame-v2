[Recent chat with TavernSystem AI]
${ctx}
AI:`;
            const res = await smartGenerate({
                user_input: " ",
                ordered_prompts: ['world_info', 'char_persona', 'chat_history', {role:'system', content:prompt}],
                quiet: true, stop: ["User:"]
            });
            addBubble(res.trim(), 'ai'); chatMem.push(`AI:${res.trim()}`);
        } catch(e) { addBubble("Err",'ai'); }
        setLoading(false);
    }
    function addBubble(t,type) {
        const b = document.getElementById('chat-history-box');
        const d = document.createElement('div'); d.className=`bubble ${type}`; d.innerText=t;
        b.appendChild(d); b.scrollTop=b.scrollHeight;
    }
    document.getElementById('chat-inp').addEventListener('keypress', (e)=>{if(e.key==='Enter')sendChat()});

    function injectDeepSeekChat() {
        if(chatMem.length === 0) { alert("暂无对话记录"); return; }
        const summary = chatMem.slice(-6).map(line => {
            return line.replace('User:', '{{user}}:').replace('AI:', 'TavernSystem:');
        }).join('\n');

        const injectText = `> [系统事件] {{user}}通过本丸灵力通道，与本丸意志进行了以下私语：\n${summary}`;
        injectInput(injectText);
        alert("对话已注入输入框！");
    }

