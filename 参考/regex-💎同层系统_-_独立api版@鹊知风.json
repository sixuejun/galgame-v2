    function parseButlerData(text) {
        const container = document.getElementById('repair-container');
        container.innerHTML = '';
        butlerData = [];
        butlerState = [];
        selectedUpgrades = {};

        const lines = text.split('\n').filter(l => l.includes('|'));
        lines.slice(0, 5).forEach((line, index) => {
            const parts = line.split('|').map(s => s.trim());
            if (parts.length < 4) return;
            var rawName = parts[0].trim();
            var riskPrices = {100: parts[1], 1000: parts[2], 5000: parts[3]};
            if(tavernStats.level >= 4) {
                var riskMatch = rawName.match(/[（(](安全|中等|危险)[）)]/);
                if(riskMatch) {
                    rawName = rawName.replace(/[（(](安全|中等|危险)[）)]/, '').trim();
                    if(riskMatch[1]==='安全') riskPrices = {200: parts[1], 1500: parts[2], 8000: parts[3]};
                    else if(riskMatch[1]==='中等') riskPrices = {100: parts[1], 1000: parts[2], 5000: parts[3]};
                    else if(riskMatch[1]==='危险') riskPrices = {50: parts[1], 500: parts[2], 2500: parts[3]};
                }
            }
            parts[0] = rawName;
            const tierKeys = Object.keys(riskPrices).map(Number).sort((a,b)=>a-b);
            const item = { name: parts[0], tiers: riskPrices, prices: tierKeys };
            butlerData.push(item);
            butlerState.push({ idx: 0 });

            const div = document.createElement('div');
            div.id = `repair-card-${index}`;
            div.className = 'repair-card';
            container.appendChild(div);
            renderRepairCard(index);
        });
        updateInvestTotal();
    }

    function renderRepairCard(index) {
        const div = document.getElementById(`repair-card-${index}`);
        const item = butlerData[index];
        const currentTierIdx = butlerState[index].idx;
        const prices = item.prices || TIER_PRICES;
        const currentPrice = prices[currentTierIdx];
        const desc = item.tiers[currentPrice];
        const isSelected = selectedUpgrades[index] === currentPrice;
        if (isSelected) div.classList.add('active-selection');
        else div.classList.remove('active-selection');

        div.innerHTML = `
            <div class="rc-head">
                <span><span class="rc-idx">#${index + 1}</span>${item.name}</span>
            </div>
            <div class="rc-slider">
                <button class="rc-arrow" onclick="changeTier(${index}, -1)">❮</button>
                <span class="rc-price">${currentPrice} G</span>
                <button class="rc-arrow" onclick="changeTier(${index}, 1)">❯</button>
            </div>
            <div class="rc-desc">${desc}</div>
            <button class="rc-btn-select ${isSelected ? 'selected' : ''}" onclick="toggleRepairSelect(${index})">
                ${isSelected ? '✔ 已加入预算' : '+ 加入预算'}
            </button>
        `;
    }

    function changeTier(index, direction) {
        let maxIdx = (butlerData[index].prices || TIER_PRICES).length - 1;
        let newIdx = butlerState[index].idx + direction;
        if (newIdx < 0) newIdx = maxIdx;
        if (newIdx > maxIdx) newIdx = 0;
        butlerState[index].idx = newIdx;
        renderRepairCard(index);
    }

    function toggleRepairSelect(index) {
        const currentTierIdx = butlerState[index].idx;
        const item = butlerData[index];
        const prices = item.prices || TIER_PRICES;
        const currentPrice = prices[currentTierIdx];
        if (selectedUpgrades[index] === currentPrice) { delete selectedUpgrades[index]; }
        else { selectedUpgrades[index] = currentPrice; }
        renderRepairCard(index); updateInvestTotal();
    }

    function updateInvestTotal() {
        let total = 0;
        Object.values(selectedUpgrades).forEach(p => total += p);
        document.getElementById('invest-total').innerText = total;
        document.getElementById('btn-invest-confirm').disabled = (total === 0);
    }

    // [修改点] 修缮提交增加余额校验
    function barrierUpgrade() {
        var barrierCosts = {1:2000, 2:6000};
        var barrierLvl = 1;
        try {
            var chatEl = window.parent.document.getElementById('chat');
            if(chatEl) {
                var msgs = chatEl.querySelectorAll('.mes_text');
                for(var i = msgs.length - 1; i >= 0; i--) {
                    var t = msgs[i].innerText || '';
                    if(t.includes('镜花水月')) { barrierLvl = 3; break; }
                    if(t.includes('偏光结界')) { barrierLvl = 2; break; }
                }
            }
        } catch(e){}
        if(barrierLvl >= 3) {
            alert("镜花水月已经是最强的伪装了哦~这么想和我一起躲起来，不被任何人找到吗♡");
            return;
        }
        var cost = barrierCosts[barrierLvl];
        if(!cost) { alert("结界已达最高等级。"); return; }
        if(tavernStats.balance < cost) {
            alert("余额不足！\n需支付: " + cost + "小判\n当前余额: " + tavernStats.balance + "小判");
            return;
        }
        var nextLvl = barrierLvl + 1;
        var names = {2:"偏光结界", 3:"镜花水月"};
        if(confirm("确认花费 " + cost + " 小判将结界升级到Lv" + nextLvl + "「" + names[nextLvl] + "」？")) {
            injectInput("> [系统事件] {{user}}花费" + cost + "小判，将幻术结界从Lv" + barrierLvl + "升级到Lv" + nextLvl + "「" + names[nextLvl] + "」。\n(更新状态栏结界信息，余额扣除" + cost + "小判。描述结界升级的过程和本丸意志的反应。)", true);
        }
    }

    function butlerSubmit() {
        if(tavernStats.level >= 5) {
            alert("主人~剩下的路不是用小判走的哦♡ 和我好好相处，基建度自然就会涨的~");
            return;
        }
        if(tavernStats.infra >= 100) {
            alert("基建度已满！当前等级的扩建已全部完成。");
            return;
        }
        let total = 0;
        let details = [];
        Object.keys(selectedUpgrades).forEach(index => {
            const price = selectedUpgrades[index];
            const item = butlerData[index];
            const desc = item.tiers[price];
            total += price;
            details.push(`${item.name} (花费${price}小判进行${desc})`);
        });

        if (total > tavernStats.balance) {
            alert(`余额不足以支付修缮费！\n需支付: ${total}\n当前余额: ${tavernStats.balance}`);
            return;
        }

        const detailStr = details.join('、');
        var newInfra = Math.min(tavernStats.infra + total / 100, 100);
        if(tavernStats.level >= 4) {
            injectInput(`> [系统事件] {{user}}花费了${total}小判，通过本丸意志进行了深化：${detailStr}。\n<sys>基建度从${tavernStats.infra}变为${newInfra}。请用<Item>CMD:ADD记录此次深化，描述包含深化内容和可能的副作用。副作用应在后续叙事中持续体现——如空间异常、灵力波动、身体反应等。如果选择了涉及"绑定""融合"方向的深化，副作用描述中应暗示不可逆性。</sys>`, true);
        } else {
            injectInput(`> [系统事件] {{user}}花费了${total}小判，使用系统的基建修缮功能，对万事屋进行了修缮：${detailStr}。\n<sys>基建度从${tavernStats.infra}变为${newInfra}</sys>`, true);
        }
    }

    // ================= 福引所 =================
    // 福引所等级效果表
    const DRAW_LEVELS = {
        1: { rateR: 0.84, rateSR: 0.15, rateSSR: 0.01, name: 'Lv.1' },
        2: { rateR: 0.72, rateSR: 0.25, rateSSR: 0.03, name: 'Lv.2' },
        3: { rateR: 0.60, rateSR: 0.35, rateSSR: 0.05, name: 'Lv.3' }
    };

    function getDrawLevel() {
        const lvl = tavernStats.level || 1;
        return DRAW_LEVELS[Math.min(lvl, 3)] || DRAW_LEVELS[1];
    }

    function doDraw(count) {
        const dl = getDrawLevel();
        const cost = count * 100;

        if (cost > tavernStats.balance) {
            alert(`小判不足！\n需支付: ${cost}小判\n当前余额: ${tavernStats.balance}小判`);
            return;
        }

        let results = [];
        for (let i = 0; i < count; i++) {
            const rand = Math.random();
            let quality = 'R';
            if (rand > 1 - dl.rateSSR) quality = 'SSR';
            else if (rand > 1 - dl.rateSSR - dl.rateSR) quality = 'SR';
            results.push(quality);
        }

        if (count === 10 && !results.some(r => r === 'SR' || r === 'SSR')) { results[9] = 'SR'; }

        renderBoxes(results);

        let injectText = "";
        if (count === 1) {
            const q = results[0];
            let lightDesc = "蓝光"; let itemLevel = "普通(R)";
            if (q === 'SR') { lightDesc = "紫光"; itemLevel = "稀有(SR)"; }
            if (q === 'SSR') { lightDesc = "耀眼的金光"; itemLevel = "传说(SSR)"; }
            injectText = `> [系统事件] {{user}}花费${cost}小判在福引所中进行了单次抽奖，随着${lightDesc}浮现，一个${itemLevel}道具被抽了出来。`;
        } else {
            const listStr = results.map(r => `[${r}]`).join('、');
            const ssrCount = results.filter(r=>r==='SSR').length;
            const srCount = results.filter(r=>r==='SR').length;
            const rCount = 10 - ssrCount - srCount;
            injectText = `> [系统事件] {{user}}花费${cost}小判在福引所中进行了十连抽奖，光芒闪烁，结果如下：\n${listStr}\n(统计：SSR×${ssrCount}，SR×${srCount}，R×${rCount})`;
        }
        injectInput(injectText, true);
    }

    function renderBoxes(qualities) {
        const grid = document.getElementById('luck-grid');
        grid.innerHTML = '';
        qualities.forEach((q, i) => {
            const div = document.createElement('div');
            div.className = `loot-box q-${q.toLowerCase()}`;
            div.style.animationDelay = (i * 0.05) + 's';
            div.innerHTML = `<div class="box-icon">📦</div><div class="box-text">${q}</div>`;
            grid.appendChild(div);
        });
        document.getElementById('luck-result').style.display = 'flex';
    }

    function closeLuckResult() { document.getElementById('luck-result').style.display = 'none'; }

    // ================= 聊天逻辑 =================
