    function renderMallList(text) {
        const con = document.getElementById('mall-list'); con.innerHTML = '';
        const lines = text.split('\n');
        if(lines.length === 0 || text.length < 5) {
             con.innerHTML = '<div style="text-align:center;color:#ccc;margin-top:50px;font-size:12px">暂无商品，请搜索关键词</div>';
             return;
        }
        lines.forEach((line, i) => {
            if(!line.includes('|')) return;
            const [emoji, name, price, sales, desc, tag] = line.split('|');
            const pVal = parseFloat(price.replace(/[^\d.]/g,'')) || 99;
            const safeName = name.trim();
            const inCart = cartData[safeName];
            const initCount = inCart ? inCart.count : 0;
            const showBtn = initCount === 0;

            const div = document.createElement('div');
            div.className = 'card';
            const isSoldOut = tag && tag.includes('缺货');
            const tagHtml = tag && tag.trim() ? `<span class="pro-tag">${tag}</span>` : '';
            const safeDesc = (desc || '好评热卖').replace(/'/g, "\\'");
            div.innerHTML = `
                <div class="c-img">${(emoji||'🎁').trim()}</div>
                <div class="c-info">
                    <div class="c-title-row">${tagHtml}<span class="c-title-txt">${safeName}</span></div>
                    <div class="c-desc">${desc||'好评热卖'}</div>
                    <div class="c-foot">
                        <div><span class="c-price">小判${pVal}</span><span class="c-sales">${sales}人付款</span></div>
                        <div class="action-box" data-name="${safeName}">
                            <button class="btn-buy" style="display:${showBtn&&!isSoldOut?'block':'none'}" onclick="plusItem('${safeName}', ${pVal}, '${safeDesc}')" ${isSoldOut?'disabled':''}>${isSoldOut?'缺货':'加入购物车'}</button>
                            <div class="qty-control ${showBtn?'':'active'}">
                                <button class="qty-btn" onclick="minusItem('${safeName}')">-</button>
                                <span class="qty-num">${initCount}</span>
                                <button class="qty-btn" onclick="plusItem('${safeName}', ${pVal}, '${safeDesc}')">+</button>
                            </div>
                        </div>
                    </div>
                </div>`;
            con.appendChild(div);
        });
        const endTip = document.createElement('div');
        endTip.className = 'end-tip'; endTip.innerText = '- 已经滑到底啦 -';
        con.appendChild(endTip);
        const con2 = document.getElementById('mall-list');
twemoji.parse(con2, { folder: 'svg', ext: '.svg' });
    }

    function plusItem(name, price, desc = '') {
        if (!cartData[name]) { cartData[name] = { name, price, count: 0, desc: desc }; }
        cartData[name].count++;
        updateGlobalItemUI(name); updateCartTotal();
    }
    function minusItem(name) {
        if (!cartData[name]) return;
        cartData[name].count--;
        if (cartData[name].count <= 0) { delete cartData[name]; }
        updateGlobalItemUI(name); updateCartTotal();
    }
    function clearCart() {
        const names = Object.keys(cartData); cartData = {};
        names.forEach(name => updateGlobalItemUI(name));
        updateCartTotal(); toggleCartDrawer(false);
    }
    function updateGlobalItemUI(name) {
        const count = cartData[name] ? cartData[name].count : 0;
        const searchBox = document.querySelector(`.action-box[data-name="${name}"]`);
        if(searchBox) {
            const btnBuy = searchBox.querySelector('.btn-buy');
            const qtyBox = searchBox.querySelector('.qty-control');
            const qtyNum = searchBox.querySelector('.qty-num');
            if(count > 0) {
                btnBuy.style.display = 'none'; qtyBox.classList.add('active'); qtyNum.innerText = count;
            } else {
                btnBuy.style.display = 'block'; qtyBox.classList.remove('active');
            }
        }
        if(document.getElementById('cart-drawer').classList.contains('open')) { renderDrawerList(); }
    }
    function updateCartTotal() {
        const bar = document.getElementById('cart-bar');
        const list = document.getElementById('mall-list');
        let tCount = 0, tPrice = 0;
        for (let k in cartData) { tCount += cartData[k].count; tPrice += cartData[k].price * cartData[k].count; }
        document.getElementById('cart-count').innerText = tCount;
        document.getElementById('cart-price').innerText = tPrice.toFixed(1);
        if(tCount > 0) { bar.classList.add('show'); list.classList.add('has-cart'); }
        else { bar.classList.remove('show'); list.classList.remove('has-cart'); toggleCartDrawer(false); }
    }
    function toggleCartDrawer(forceState) {
        const drawer = document.getElementById('cart-drawer');
        const mask = document.getElementById('cart-mask');
        const icon = document.getElementById('cart-toggle-icon');
        const isOpen = drawer.classList.contains('open');
        const nextState = forceState !== undefined ? forceState : !isOpen;
        if (nextState) {
            renderDrawerList(); drawer.classList.add('open'); mask.classList.add('open'); icon.innerText = '▼';
        } else {
            drawer.classList.remove('open'); mask.classList.remove('open'); icon.innerText = '▲';
        }
    }
    function renderDrawerList() {
        const container = document.getElementById('drawer-list-con'); container.innerHTML = '';
        const items = Object.values(cartData);
        if(items.length === 0) { container.innerHTML = '<div style="text-align:center;color:#999;margin-top:20px;font-size:12px">购物车空空如也</div>'; return; }
        items.forEach(item => {
            const div = document.createElement('div'); div.className = 'drawer-item';
            const safeDesc = (item.desc || '').replace(/'/g, "\\'");
            div.innerHTML = `
                <div><div class="d-name">${item.name}</div><div class="d-price">小判${item.price}</div></div>
                <div class="qty-control active" style="border:1px solid #eee">
                    <button class="qty-btn" onclick="minusItem('${item.name}')">-</button>
                    <span class="qty-num">${item.count}</span>
                    <button class="qty-btn" onclick="plusItem('${item.name}', ${item.price}, '${safeDesc}')">+</button>
                </div>`;
            container.appendChild(div);
        });
    }

    // [修改点] 商城结算增加余额校验
    function mallCheckout() {
        let grandTotal = 0;
        const items = Object.values(cartData);
        if(items.length === 0) return;

        items.forEach(i => grandTotal += i.price * i.count);

        // 余额检查
        if (grandTotal > tavernStats.balance) {
            alert(`余额不足!\n需支付: ${grandTotal}\n当前余额: ${tavernStats.balance}`);
            return;
        }

        const itemStr = items.map(i => {
            const total = i.price * i.count;
            const tStr = Number.isInteger(total) ? total : total.toFixed(1);
            // 添加商品描述(如果有的话)
            const descPart = i.desc ? `("${i.desc}")` : '';
            return `${i.count}个${i.name}${descPart}(小判${tStr})`;
        }).join('、');
        const gStr = Number.isInteger(grandTotal) ? grandTotal : grandTotal.toFixed(1);

        injectInput(`{{user}}在万事屋商铺购买了${itemStr},总共消费了${gStr}小判。`);
    }

    // ================= 本丸管家 (左右切换版) =================
    let butlerData = [];
    let butlerState = [];
    let selectedUpgrades = {};
    const TIER_PRICES = [100, 1000, 5000];

        async function startButlerScan() {
