                if (k.includes('报酬') || k.includes('允诺')) valHtml = `<span style="color:#d35400;">${v}</span>`;
                infoHtml += `<div><span class="th-staff-key" style="font-weight:700;">${k}</span>: <span style="color:#8a786a;">${valHtml}</span></div>`;
