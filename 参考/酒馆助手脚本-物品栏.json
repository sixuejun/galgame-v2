            <div class="th-edit-actions">
                <div class="th-btn" onclick="$('#${CONFIG.domEditId}').fadeOut(150)">取消</div>
                <div class="th-btn save-btn">保存并更新</div>
            </div>
        </div>
        `;
        $('body').append(ballHtml + panelHtml);
        bindBallEvents();
        bindStorageDragEvents();
        bindDetailPopupDrag();
        $('#th-tab-inv').on('click', () => switchTab('inventory'));
        $('#th-tab-price').on('click', () => switchTab('price'));
        $('#th-tab-staff').on('click', () => switchTab('staff'));
        $('#th-tab-infra').on('click', () => switchTab('infra'));
        $('#th-tab-ach').on('click', () => switchTab('achievement'));
        $('#th-tab-guest').on('click', () => switchTab('guest'));
        $('#th-tab-settings').on('click', () => switchTab('settings'));
        $('#th-main-close-btn').on('click', (e) => { e.stopPropagation(); togglePanel(); });
        $('#th-scale-minus').on('click', (e) => { e.stopPropagation(); updateUIScale(uiScale - 0.1); });
        $('#th-scale-plus').on('click', (e) => { e.stopPropagation(); updateUIScale(uiScale + 0.1); });
        $('#th-night-toggle').on('click', (e) => { e.stopPropagation(); toggleNightMode(); });
    }

    function toggleBallVisibility() {
        const $ball = $('#' + CONFIG.domBallId);
        if ($ball.length === 0) { createUI(); return; }
        if (isBallVisible) {
            $ball.hide(); isBallVisible = false;
            if(window.toastr) toastr.info('悬浮球已隐藏', '系统');
        } else {
            $ball.show(); isBallVisible = true;
            if(window.toastr) toastr.info('悬浮球已显示', '系统');
        }
    }

    function togglePanel() {
        const $panel = $('#' + CONFIG.domPanelId);
        if (isPanelOpen) {
            $panel.fadeOut(150);
            isPanelOpen = false;
            closeDetailPopup();
            closeEditPopup();
            $('#' + CONFIG.domStorageId).fadeOut(150);
            isStorageOpen = false;
        } else {
            isPanelOpen = true;
            // 打开面板时把所有Tab都标为脏（确保渲染最新数据）
            ['inventory', 'staff', 'achievement', 'price', 'infra', 'guest'].forEach(t => dirtyTabs.add(t));
            performScan('incremental'); // 优先增量扫（有检查点时很快），无检查点自动退化为全量
            $panel.css({'display':'flex','opacity':0}); thResizePriceInputs(); $panel.animate({opacity:1}, 150);
            updateUIScale();
            applyNightMode();
            // 面板显示后立即渲染当前 Tab，不等扫描回调（修复首开空白问题）
            renderActiveTab();
        }
    }

    function showItemDetail(item, isStoredItem = false, sourceType = 'main', staffName = null) {
        const $popup = $('#th-detail-popup-ui');
        const $panel = $('#' + CONFIG.domPanelId);
        // 每次打开时重置位置，避免上次拖拽后位置偏移残留
        $popup.css({ left: '50%', transform: 'translateX(-50%)' });
        $popup.find('.icon-area').html(item.icon);
        $popup.find('.name-text').text(item.name);
        $popup.find('.id-area').text(`ID: ${item.id}`);
        $popup.find('.desc-area').text(item.desc || "无描述");

        const $btnArea = $popup.find('.btn-area').empty();

        const $editBtn = $(`<div style="cursor: pointer; font-size: 16px; opacity: 0.6;" title="编辑">✏️</div>`);
        $editBtn.on('click', (e) => {
            e.stopPropagation();
            editItemAction(item);
        });
        $btnArea.append($editBtn);

        const $delBtn = $(`<div class="del-btn" style="cursor: pointer; font-size: 16px; opacity: 0.6;" title="丢弃">🗑️</div>`);
        $delBtn.on('click', (e) => { e.stopPropagation(); deleteItemAction(item.id, item.name); });
        $btnArea.append($delBtn);

        // 【修改③】为PC端添加操作按钮
        if (sourceType === 'from_main') {
            // 从主背包查看：添加"放入杂物间"按钮
            const $toStorageBtn = $(`<div style="cursor: pointer; font-size: 16px; opacity: 0.6;" title="放入杂物间">🏚️</div>`);
            $toStorageBtn.on('click', (e) => {
                e.stopPropagation();
                moveToStorage(item.id);
                closeDetailPopup();
            });
            $btnArea.append($toStorageBtn);
        } else if (sourceType === 'from_storage') {
            // 从杂物间查看：添加"取出"和"分配给员工"按钮
            const $retrieveBtn = $(`<div style="cursor: pointer; font-size: 16px; opacity: 0.6;" title="取出到背包">🌸</div>`);
            $retrieveBtn.on('click', (e) => {
                e.stopPropagation();
                retrieveFromStorage(item.id);
            });
            $btnArea.append($retrieveBtn);

            // 如果员工栏开启，显示分配按钮
            if ($('#th-list-staff').is(':visible')) {
                const $assignBtn = $(`<div style="cursor: pointer; font-size: 16px; opacity: 0.6;" title="分配给员工">👤</div>`);
                $assignBtn.on('click', (e) => {
                    e.stopPropagation();
                    // 标记此物品为"待分配"，提示用户点击员工槽
                    $popup.data('pending-assign-item', item.id);
                    $('.th-staff-slot:not(.filled)').addClass('th-assign-hint');
                    if(window.toastr) toastr.info('请点击员工的空槽位', '分配物品');
                });
                $btnArea.append($assignBtn);
            }

            // 如果价目板开启，显示上架按钮
            if ($('#th-list-price').is(':visible')) {
                const $toPriceBtn = $(`<div style="cursor: pointer; font-size: 16px; opacity: 0.6;" title="上架到价目板">💰</div>`);
                $toPriceBtn.on('click', (e) => {
                    e.stopPropagation();
                    $popup.data('pending-price-item', item.id);
                    $('.th-price-slot:not(.filled)').addClass('th-assign-hint');
                    if(window.toastr) toastr.info('请点击空货架槽位', '上架物品');
                    $popup.hide(); // 关闭详情弹窗，避免遮挡槽位
                });
                $btnArea.append($toPriceBtn);
            }
        } else if (sourceType === 'from_staff') {
            // 从员工槽查看：添加"收回杂物间"按钮
            const $returnBtn = $(`<div style="cursor: pointer; font-size: 16px; opacity: 0.6;" title="收回杂物间">🏚️</div>`);
            $returnBtn.on('click', (e) => {
                e.stopPropagation();
                moveStaffToStorage(item.id, staffName);
                closeDetailPopup();
            });
            $btnArea.append($returnBtn);
        }

        $popup.find('.close-btn').off('click').on('click', (e) => { e.stopPropagation(); closeDetailPopup(); });
        parseEmoji($popup[0]);

        // 智能计算详情弹窗位置，避免遮挡操作区域
        if (sourceType === 'from_price') {
            // 货架物品：详情页始终放在上方（因为点击后杂物间会随之弹出在下方）
            $popup.css('top', '20%');
        } else if ($panel.length && $panel.is(':visible')) {
            if (isStorageOpen) {
                // 杂物间已打开时，根据当前标签决定位置
                const isPriceTabActive = $('#th-tab-price').hasClass('active');
                const isStaffTabActive = $('#th-tab-staff').hasClass('active');
                $popup.css('top', (isPriceTabActive || isStaffTabActive) ? '20%' : '40%');
            } else {
                // 杂物间未打开，放在主面板下方
                const topPos = (parseFloat($panel.css('top')) || 120) + $panel.outerHeight() + 12;
                $popup.css('top', topPos + 'px');
            }
        } else {
            $popup.css('top', '200px');
        }
        $popup.css('display', 'block').show();
    }

    function closeDetailPopup() {
        const $popup = $('#th-detail-popup-ui');
        $popup.hide();
        // 【修改③】清除PC端操作提示状态
        $popup.removeData('pending-assign-item');
        $popup.removeData('pending-price-item');
        $('.th-staff-slot').removeClass('th-assign-hint');
        $('.th-price-slot').removeClass('th-assign-hint');
    }

    function toggleStoragePopup() {
        const $storage = $('#' + CONFIG.domStorageId);
        const $panel = $('#' + CONFIG.domPanelId);
        if (isStorageOpen) {
            $storage.fadeOut(150);
            isStorageOpen = false;
        } else {
            if ($panel.length && $panel.is(':visible')) {
                const rect = $panel[0].getBoundingClientRect();
                const topPos = rect.bottom + 10;
                $storage.css('top', topPos + 'px');
            } else {
                $storage.css('top', '430px');
            }
            renderStorageItems();
            $storage.css('display', 'flex').hide().fadeIn(150);
            isStorageOpen = true;
        }
    }

    function switchTab(tab) {
        const $invTab = $('#th-tab-inv'); const $priceTab = $('#th-tab-price'); const $staffTab = $('#th-tab-staff');
        const $infraTab = $('#th-tab-infra'); const $achTab = $('#th-tab-ach'); const $guestTab = $('#th-tab-guest'); const $settingsTab = $('#th-tab-settings');
        const $invList = $('#th-list-inv'); const $priceList = $('#th-list-price'); const $staffList = $('#th-list-staff');
        const $infraList = $('#th-list-infra'); const $achList = $('#th-list-ach'); const $guestList = $('#th-list-guest'); const $settingsList = $('#th-list-settings');
        const $panelInner = $('#th-panel-inner');
        const $pins = $('.th-pin');
        const $invCounter = $('#th-inv-counter');
        const $achCounter = $('#th-ach-counter');

        // 全部取消激活 / 全部隐藏
        [$invTab,$priceTab,$staffTab,$infraTab,$achTab,$guestTab,$settingsTab].forEach($t => $t.removeClass('active'));
        [$invList,$priceList,$staffList,$infraList,$achList,$guestList,$settingsList].forEach($l => $l.hide());
        $('#th-footer-price-nav').remove(); // 离开价目tab时清除页脚导航按钮

        $panelInner.removeClass('th-style-paper').removeClass('th-shelf-mode');
        $pins.hide();
        $invCounter.hide();
        $achCounter.hide();

        if (tab === 'inventory') {
            $invTab.addClass('active');
            $invList.css('display', 'grid');
            $invCounter.show();
            if (dirtyTabs.has('inventory') || $invList.children().length === 0) {
                renderInventory(); dirtyTabs.delete('inventory');
            }
        } else if (tab === 'price') {
            $priceTab.addClass('active');
            $priceList.css('display', 'flex');
            thResizePriceInputs();
            // 根据子视图决定是否启用paper样式，不能无条件加
            if (priceSubView === 'shelf') {
                $panelInner.removeClass('th-style-paper').addClass('th-shelf-mode');
                $pins.hide();
            } else {
                $panelInner.removeClass('th-shelf-mode').addClass('th-style-paper');
                $pins.show();
            }
            if (dirtyTabs.has('price') || $priceList.children().length === 0) {
                if (priceSubView === 'shelf') renderPriceShelf();
                else renderPriceBoard();
                dirtyTabs.delete('price');
            }
// 确保导航按钮始终存在
$('#th-footer-price-nav').remove();
const _navLabel = priceSubView === 'shelf' ? '← 价目表' : '货架&amp;公告 →';
const $_nav = $('<div id="th-footer-price-nav" class="th-price-subnav" style="position:static;margin-left:6px;">' + _navLabel + '</div>');
$_nav.on('click', () => { if (priceSubView === 'shelf') { priceSubView = 'board'; renderPriceBoard(); } else { priceSubView = 'shelf'; renderPriceShelf(); } });
$('#th-night-toggle').after($_nav);
        } else if (tab === 'staff') {
            $staffTab.addClass('active');
            $staffList.css('display', 'flex');
            if (dirtyTabs.has('staff') || $staffList.children().length === 0) {
                renderStaffBoard(getVars()[CONFIG.varStaffKey] || []); dirtyTabs.delete('staff');
            }
        } else if (tab === 'infra') {
            $infraTab.addClass('active');
            $infraList.css('display', 'flex');
            if (dirtyTabs.has('infra') || $infraList.children().length === 0) {
                renderInfraBoard(getVars()[CONFIG.varRenoKey] || []); dirtyTabs.delete('infra');
            }
        } else if (tab === 'achievement') {
            $achTab.addClass('active');
            $achList.css('display', 'flex');
            $achCounter.show();
            if (dirtyTabs.has('achievement') || $achList.children().length === 0) {
                renderAchievements(); dirtyTabs.delete('achievement');
            }
        } else if (tab === 'guest') {
            $guestTab.addClass('active');
            $guestList.css('display', 'flex');
            if (dirtyTabs.has('guest') || $guestList.children().length === 0) {
                renderGuestLog(getVars()[CONFIG.varGuestLogKey] || []); dirtyTabs.delete('guest');
            }
        } else if (tab === 'settings') {
            $settingsTab.addClass('active');
            $settingsList.css('display', 'flex');
            renderSettings(); // 内部有幂等保护，只渲染一次
        }
    }

        function thResizePriceInputs() {
        $('#th-list-price .th-price-input').each(function() {
            this.style.width = '1px';
            this.style.width = (this.scrollWidth + 4) + 'px';
        });
    }

    function renderPriceBoard() {
        flushPriceSave(); // 先把未保存的编辑同步到 chatVar，防止 re-render 丢失
        const $list = $('#th-list-price');
        $list.empty();
        // 价目板视图：恢复paper背景和钉子，移除货架模式
        $('#th-panel-inner').removeClass('th-shelf-mode').addClass('th-style-paper');
        $('.th-pin').show();

        const $header = $('<div class="th-price-title">価目表 <span class="th-add-btn">✏️</span><span class="th-price-export-btn" title="导出价目表">📤</span><span class="th-price-import-btn" title="导入价目表">📥</span></div>');
        $header.find('.th-add-btn').on('click', () => addPriceRow());
        $header.find('.th-price-export-btn').on('click', () => exportPriceData());
        $header.find('.th-price-import-btn').on('click', () => importPriceData());
        $list.append($header);

        const data = getPriceData();
        const itemCount = data.length - 1;

        // 渲染文本行
        for (let i = 0; i < itemCount; i++) {
            const rowData = data[i] || { name: "", price: "" };
            const $row = $(`
                <div class="th-price-row normal">
                    <input type="text" class="th-price-input name-input" placeholder="____" value="${rowData.name}" style="text-align: left;">
                    <div class="th-price-dots"></div>
                    <input type="text" class="th-price-input price-input" placeholder="____" value="${rowData.price}" style="text-align: right;">
                </div>
            `);
            $list.append($row);
            $row.find('.th-price-input').on('input', function() {
                this.style.width = '1px';
                this.style.width = (this.scrollWidth + 4) + 'px';
            });
        }

        const noteData = data[itemCount] || { note: "" };
        const $row5 = $(`
            <div class="th-price-row special">
                <div class="th-price-fixed">主人特别慰藉</div>
                <input type="text" class="th-price-input note-input th-price-note-input" placeholder="____" value="${noteData.note}">
                <div class="th-price-dots"></div>
                <div class="th-price-fixed">面议</div>
            </div>
        `);
        $list.append($row5);

        isInitializingPriceBoard = true;
        $list.find('.th-price-input').each(function(){ onPriceInputChange.call(this); });
        isInitializingPriceBoard = false;
        $list.find('.th-price-input').on('input', onPriceInputChange);

        // 失焦自动移除空白行
        $list.find('.th-price-row.normal .th-price-input').on('blur', function() {
            const $row = $(this).closest('.th-price-row.normal');
            const name = $row.find('.name-input').val().trim();
            const price = $row.find('.price-input').val().trim();
            if (!name && !price) {
                savePriceData();
                setTimeout(() => renderPriceBoard(), 50);
            }
        });

        // 将导航按钮注入页脚，与日夜按钮并排
        $('#th-footer-price-nav').remove();
        const $navBtn = $('<div id="th-footer-price-nav" class="th-price-subnav" style="position:static;margin-left:6px;">货架&amp;公告 →</div>');
        $navBtn.on('click', () => { priceSubView = 'shelf'; renderPriceShelf(); });
        $('#th-night-toggle').after($navBtn);

        parseEmoji($list[0]);

        // 隐藏旧货架区域（槽位已移至子视图）

    }

    function renderPriceShelf() {
        const $list = $('#th-list-price');
        $list.empty();
        // 货架视图：去掉paper背景和钉子，背景改为 var(--th-inv-outer)
        $('#th-panel-inner').removeClass('th-style-paper').addClass('th-shelf-mode');
        $('.th-pin').hide();

        const fullInventory = getVars()[CONFIG.varDataKey] || [];
        const slotsData = getPriceSlotsData();
        const noticeText = (getVars()[CONFIG.varNoticeKey] || '').replace(/</g,'&lt;').replace(/>/g,'&gt;');

        // 构建3个货架盒，每盒2个槽位（共6个槽）
        let shelfBoxesHtml = '';
        for (let boxIdx = 0; boxIdx < 3; boxIdx++) {
            let slotsInnerHtml = '';
            for (let i = 0; i < 2; i++) {
                const slotIdx = boxIdx * 2 + i;
                const slot = slotsData[slotIdx] || { id: null, price: '' };
                let iconHtml = '';
                let filledClass = '';
                if (slot.id) {
                    const item = fullInventory.find(it => it.id === slot.id);
                    if (item) {
                        iconHtml = `<div class="th-staff-slot-icon">${item.icon}</div>`;
                        filledClass = 'filled';
                    }
                }
                slotsInnerHtml += `
                    <div class="th-price-slot-wrapper">
                        <div class="th-staff-slot th-price-slot ${filledClass}" data-slot-index="${slotIdx}" data-item-id="${slot.id || ''}">
                            ${iconHtml}
                        </div>
                        <input class="th-price-slot-input" type="text" placeholder="定价" value="${slot.price}">
                    </div>`;
            }
            shelfBoxesHtml += `
                <div class="th-shelf-box">
                    <svg width="100%" height="100%" style="position:absolute;top:0;left:0;pointer-events:none;z-index:0;">
                        <rect x="1" y="1" width="128" height="62" rx="2" fill="#D49F74" stroke="#B58C67" stroke-width="2"/>
                        <rect x="6" y="1" width="118" height="56" fill="none" stroke="#B58C67" stroke-width="2"/>
                        <line x1="1" y1="63" x2="6" y2="57" stroke="#B58C67" stroke-width="2"/>
                        <line x1="129" y1="63" x2="124" y2="57" stroke="#B58C67" stroke-width="2"/>
                    </svg>
                    <div class="th-shelf-box-inner">${slotsInnerHtml}</div>
                </div>`;
        }

        $list.html(`<div class="th-shelf-view-new">
            <div class="th-notice-col">
                <svg style="position:absolute;top:0;left:0;width:100%;height:50px;z-index:10;pointer-events:none;overflow:visible;">
                    <line x1="50%" y1="-10" x2="25%" y2="24" stroke="#b08d72" stroke-width="1.5"/>
                    <line x1="50%" y1="-10" x2="75%" y2="24" stroke="#b08d72" stroke-width="1.5"/>
                    <circle cx="25%" cy="24" r="2.5" fill="#fdf5e6" stroke="#b08d72" stroke-width="1.5"/>
                    <circle cx="75%" cy="24" r="2.5" fill="#fdf5e6" stroke="#b08d72" stroke-width="1.5"/>
                    <circle cx="50%" cy="-10" r="3.5" fill="#fdf5e6" stroke="#b08d72" stroke-width="1.5"/>
                </svg>
                <div class="th-notice-board">
                    <div class="th-notice-paper">
                        <textarea class="th-notice-text" placeholder="在这里写下今日的特惠信息或是留给来访者的口信...">${noticeText}</textarea>
                    </div>
                </div>
            </div>
            <div class="th-shelf-col">
                <div id="th-shelf-slots-inner">${shelfBoxesHtml}</div>
            </div>
        </div>`);

        // 将返回按钮注入页脚，与日夜按钮并排
        $('#th-footer-price-nav').remove();
        const $backBtn = $('<div id="th-footer-price-nav" class="th-price-subnav" style="position:static;margin-left:6px;">← 价目表</div>');
        $backBtn.on('click', () => { priceSubView = 'board'; renderPriceBoard(); });
        $('#th-night-toggle').after($backBtn);

        // 绑定公告文本自动保存
        $list.find('.th-notice-text').on('input', function() {
            const val = $(this).val();
            if (typeof TavernHelper !== 'undefined') {
                TavernHelper.insertOrAssignVariables({ [CONFIG.varNoticeKey]: val }, { type: 'chat' });
            }
        });

        // 绑定槽位输入同步
        isInitializingPriceBoard = true;
        $('#th-shelf-slots-inner .th-price-slot-input').each(function(){ onPriceInputChange.call(this); });
        isInitializingPriceBoard = false;
        $('#th-shelf-slots-inner .th-price-slot-input').on('input', onPriceInputChange);

        // 货架已填槽：绑定拖拽（拖到杂物间可下架）
        $('#th-shelf-slots-inner').find('.th-price-slot.filled').each(function() {
            const slotIdx = $(this).data('slot-index');
            const slotItem = fullInventory.find(it => it.id === slotsData[slotIdx].id);
            if (slotItem) bindDragEvents($(this), slotItem, 'from_price', slotIdx);
        });
        // 货架盒整体点击：全高度覆盖，左/右半边分别对应两个槽
        $('#th-shelf-slots-inner').find('.th-shelf-box').on('click', function(e) {
            // input 自身点击不冒泡处理
            if ($(e.target).is('.th-price-slot-input')) return;
            const rect = this.getBoundingClientRect();
            const isRight = (e.clientX - rect.left) > rect.width / 2;
            const boxes = $('#th-shelf-slots-inner').find('.th-shelf-box');
            const boxIdx = boxes.index(this);
            const slotIdx = boxIdx * 2 + (isRight ? 1 : 0);
            const slot = slotsData[slotIdx] || { id: null };

            if (slot && slot.id) {
                const item = fullInventory.find(it => it.id === slot.id);
                if (item) {
                    const $popup = $('#th-detail-popup-ui');
                    showItemDetail(item, false, 'from_price');
                    const $btnArea = $popup.find('.btn-area').empty();
                    const $editBtn = $(`<div style="cursor:pointer;font-size:16px;opacity:0.6" title="编辑">✏️</div>`);
                    $editBtn.on('click', (e) => { e.stopPropagation(); editItemAction(item); });
                    const $delBtn = $(`<div class="del-btn" style="cursor:pointer;font-size:16px;opacity:0.6" title="丢弃">🗑️</div>`);
                    $delBtn.on('click', (e) => { e.stopPropagation(); deleteItemAction(item.id, item.name); });
                    const $removeBtn = $(`<div style="cursor:pointer;font-size:16px;opacity:0.6" title="下架至杂物间">🏚️</div>`);
                    $removeBtn.on('click', (e) => { e.stopPropagation(); removeItemFromPriceSlot(slotIdx); closeDetailPopup(); });
                    $btnArea.append($editBtn, $delBtn, $removeBtn);
                }
                toggleStoragePopup();
            } else {
                const $popup = $('#th-detail-popup-ui');
