                moveStorageToStaff(pendingItemId, staffName);
                $popup.removeData('pending-assign-item');
                $('.th-staff-slot').removeClass('th-assign-hint');
                closeDetailPopup();
            } else {
                toggleStoragePopup(); // ④ 弹杂物间提示用户先选物品
            }
        });

        $list.find('.th-staff-slot.filled').each(function() {
             const itemId = $(this).data('item-id');
             const staffName = $(this).data('staff');
             const item = fullInventory.find(it => it.id === String(itemId));
             if (item) {
                 bindDragEvents($(this), item, 'from_staff', staffName);
             }
        });

        parseEmoji($list[0]);
    }

