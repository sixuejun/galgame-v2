    function bindDetailPopupDrag() {
        const $popup = $('#th-detail-popup-ui');
        const $handle = $popup; // 整个弹窗顶部12px作为拖拽热区
        const handleEl = $popup[0];
        if (!handleEl) return;

        const TOP_ZONE = 12; // 顶部热区高度(px)

        function isInTopZone(clientY) {
            const r = handleEl.getBoundingClientRect();
            return clientY - r.top <= TOP_ZONE;
        }

        function snapToReal() {
            const r = handleEl.getBoundingClientRect();
            $popup.css({ left: r.left + 'px', top: r.top + 'px', transform: 'none' });
            return { left: r.left, top: r.top };
        }

        // ── 触控拖拽 ──
        let touchDragging = false;
        let startX, startY, initL = undefined, initT;

        $handle.on('touchstart', e => {
            const t = e.touches[0];
            if (!isInTopZone(t.clientY)) return;
            touchDragging = false;
            startX = t.clientX; startY = t.clientY;
            const pos = snapToReal();
            initL = pos.left; initT = pos.top;
        });
        $handle.on('touchmove', e => {
            // startX/startY 只在 touchstart 时（顶部热区内）才被赋值，否则 initL/initT 为 undefined，不会移动
            if (initL === undefined) return;
            const t = e.touches[0];
            const moveX = t.clientX - startX, moveY = t.clientY - startY;
            if (Math.abs(moveX) > 5 || Math.abs(moveY) > 5) {
                touchDragging = true;
                $popup.css({ left: initL + moveX + 'px', top: initT + moveY + 'px' });
            }
            if (touchDragging) e.preventDefault();
        });
        $handle.on('touchend touchcancel', () => { touchDragging = false; initL = undefined; });

        // ── 鼠标拖拽 ──
        let mouseDragging = false, isMouseDown = false;

        handleEl.addEventListener('pointerdown', e => {
            if (e.pointerType !== 'mouse' || e.button !== 0) return;
            if (!isInTopZone(e.clientY)) return;
            isMouseDown = true;
            mouseDragging = false;
            startX = e.clientX; startY = e.clientY;
            const pos = snapToReal();
            initL = pos.left; initT = pos.top;
            try { handleEl.setPointerCapture(e.pointerId); } catch(err) {}
            e.preventDefault();
        });
        handleEl.addEventListener('pointermove', e => {
            if (e.pointerType !== 'mouse' || !isMouseDown) return;
            const moveX = e.clientX - startX, moveY = e.clientY - startY;
            if (!mouseDragging && (Math.abs(moveX) > 5 || Math.abs(moveY) > 5)) {
                mouseDragging = true;
                handleEl.style.cursor = 'grabbing';
            }
            if (mouseDragging) {
                $popup.css({ left: initL + moveX + 'px', top: initT + moveY + 'px' });
            }
        });
        handleEl.addEventListener('pointerup', e => {
            if (e.pointerType !== 'mouse') return;
            isMouseDown = false;
            mouseDragging = false;
            handleEl.style.cursor = '';
        });
        handleEl.addEventListener('pointercancel', e => {
            if (e.pointerType !== 'mouse') return;
            isMouseDown = false;
            mouseDragging = false;
        });
    }

    function bindEvents() {
        if (typeof tavern_events === 'undefined') return;
        // 新消息到来：使用增量扫描（只扫新楼层，速度快）
        eventOn(tavern_events.CHARACTER_MESSAGE_RENDERED, () => scheduleScan('incremental'));
        // 删楼、回滚、修改楼层：先作废检查点，再全量重扫（防止旧快照污染增量结果）
        [tavern_events.MESSAGE_DELETED, tavern_events.MESSAGE_SWIPED, tavern_events.MESSAGE_UPDATED]
            .forEach(e => eventOn(e, () => { clearCheckpoint(); scheduleScan('full'); }));
        // 生成开始时立即全量扫，并更新检查点，为后续增量扫打好基础
        eventOn('generation_started', () => { if (debounceTimer) clearTimeout(debounceTimer); const _cp = getCheckpoint(); if (_cp) { scheduleScan('incremental'); } else { performScan('full'); } });
        eventOn(tavern_events.CHAT_CHANGED, () => {
    $('[id^="th-fixed"]').remove();
    $('#' + CONFIG.domBallId).remove();
    $('#th-detail-popup-ui').remove();
    $('.th-drag-helper').remove();
    isPanelOpen = false;
    isStorageOpen = false;
    isBallVisible = true;   // 重置状态
    setTimeout(createUI, 100); // 稍作延迟，等新角色卡加载完再重建悬浮球
        });
        if (typeof getButtonEvent !== 'undefined') {
            const btnEvent = getButtonEvent(CONFIG.toggleButtonName);
            eventOn(btnEvent, () => { toggleBallVisibility(); });
        }
    }

