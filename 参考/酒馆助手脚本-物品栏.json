function normalize(str) {
    return String(str || "").replace(/\s+/g, "").replace(/[（(][^)）]*[)）]/g, "").replace(/[、，,。.·・\-]/g, "").normalize("NFKC");
}

function extractDateKey(str) {
    if (!str) return "";
    const lastRi = str.lastIndexOf("日");
    if (lastRi === -1) return normalize(str);
    const lastYue = str.lastIndexOf("月", lastRi);
    if (lastYue === -1) return normalize(str);
    const monthPart = str.substring(Math.max(0, lastYue - 2), lastYue);
    const dayPart = str.substring(lastYue + 1, lastRi);
    return normalize(monthPart + dayPart);
}

    function checkDeparturePrompt(guestList) {
        const normalize = (str) => {
            if (!str) return "";
            return String(str).replace(/\s+/g, "").replace(/[（(][^)）]*[)）]/g, "").replace(/[、，,。.·・\-]/g, "").normalize("NFKC").trim();
        };

        // 获取 MVU 变量 (保持不变)
        let rawToday = "";
        try {
            const mvuInterface = window.Mvu || (window.parent && window.parent.Mvu);
            if (mvuInterface) {
                const mvuData = mvuInterface.getMvuData({ type: 'message', message_id: 'latest' });
                if (mvuData && mvuData.stat_data && mvuData.stat_data['当前时间']) rawToday = mvuData.stat_data['当前时间'];
                else {
                    const chatData = mvuInterface.getMvuData({ type: 'chat' });
                    if (chatData && chatData.stat_data && chatData.stat_data['当前时间']) rawToday = chatData.stat_data['当前时间'];
                }
            }
        } catch (e) { console.error(e); }

        const cleanToday = normalize(rawToday);
        if (!cleanToday) return;

        let triggerLines = [];

        if (Array.isArray(guestList)) {
            guestList.forEach(g => {
                const effectiveDateStr = g.custom_date || g.date_range;
                if (!effectiveDateStr) return;

                const rangeParts = effectiveDateStr.split(/[~～]/);
                if (rangeParts.length >= 2) {
                    const rawCheckOut = rangeParts[1];
                    const cleanCheckOut = extractDateKey(rawCheckOut);
                    const todayKey = extractDateKey(rawToday);

                    let groupName = "未知来访者";
                    if (g.roles && g.roles.length > 0) {
                        groupName = g.roles[0]['姓名'] || g.roles[0]['Name'] || "某来访者";
                    }
                    let othersStr = g.others ? `${g.others}` : "";

                    if (cleanCheckOut === todayKey) {
                        // 退房日=今天：首次触发，设置标记
                        g.departure_prompted = true;
                        triggerLines.push(`注意，今日计划离开的来访者团体有：${groupName}（${othersStr}），请自然合理的安排离店剧情，并在正文末尾输出<Guest_Departure>标签。`);
                    } else if (g.departure_prompted) {
                        // 退房日已过但来客仍未离店：持续提醒
                        triggerLines.push(`注意，${groupName}（${othersStr}）的预定退房日已过但仍未离店。请在本轮安排其离店，并输出<Guest_Departure>标签。如果剧情中住宿已延长，请用户在住客记录面板中更新日期。`);
                    }
                }
            });
        }

        // 注入 Prompt (保持不变)
        if (triggerLines.length > 0) {
            // if(window.toastr) toastr.success("触发离店剧情!", "系统");
            const content = `<Story_Guidance>\n[剧情引导]\n${triggerLines.join('\n')}\n</Story_Guidance>`;
            const injection = { id: CONFIG.departurePromptId, position: 'in_chat', depth: 2, role: 'system', content: content, should_scan: true };
            if (typeof injectPrompts !== 'undefined') injectPrompts([injection]);
        } else {
            if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.departurePromptId]);
        }
    }

    // =================================================================
    // === 刷新 AI 可见的来访者 Prompt (支持手动修改与备注) ===
    // =================================================================
    function _notNA(v) { return v && !/^n\/?\.?a\.?$/i.test(v.trim()) ? v : ''; }
    function archiveGuest(guest, messageText, currentArchive) {
            if (!Array.isArray(currentArchive)) currentArchive = [];
            var role = (guest.roles && guest.roles[0]) || {};
            var outcome = '已离店', note = '', departureDarkfall = '', departureAppearance = '', departurePersonality = '', departureIntimacy = '', departureMasterRel = '';
            var _archiveName = normalize(role['姓名'] || role['Name'] || '');
            var depMatch = messageText.match(/<Guest_Departure>\s*(.*?)\s*<\/Guest_Departure>/i);
            if (depMatch) {
                var _dmName = normalize(depMatch[1].split('|')[0]);
                if (_dmName !== _archiveName) depMatch = null;
            }
            if (!depMatch) {
                try {
                    var _allMsgs = getChatMessages('0-{{lastMessageId}}');
                    if (_allMsgs && _allMsgs.length > 0) {
                        for (var _mi = _allMsgs.length - 1; _mi >= Math.max(0, _allMsgs.length - 5); _mi--) {
                            var _mt = _allMsgs[_mi].message || _allMsgs[_mi].mes || '';
                            var _allDep = _mt.matchAll(/<Guest_Departure>\s*(.*?)\s*<\/Guest_Departure>/gi);
                            for (var _dm of _allDep) {
                                var _candidateName = normalize(_dm[1].split('|')[0]);
                                if (_candidateName === _archiveName) { depMatch = _dm; break; }
                            }
                            if (depMatch) break;
                        }
                    }
                } catch(_e) {}
            }
            if (depMatch) {
                var parts = depMatch[1].split('|');
                if (parts[1]) outcome = parts[1].trim();
                if (parts[2]) note = parts[2].trim();
                if (parts[3]) departureDarkfall = parts[3].trim();
                if (parts[4]) departureAppearance = parts[4].trim();
                if (parts[5]) departurePersonality = parts[5].trim();
                if (parts[6]) departureIntimacy = parts[6].trim();
                if (parts[7]) departureMasterRel = parts[7].trim();
            }
            var _dateRange = guest.custom_date || guest.date_range || '';
            var _isDuplicate = currentArchive.some(function(entry) {
                return normalize(entry.name) === _archiveName && entry.date_range === _dateRange;
            });
            if (_isDuplicate) return currentArchive;
            currentArchive.push({
                name: role['姓名'] || role['Name'] || '未知',
                type: _notNA(role['刀种']) || _notNA(role['职业']) || '',
                affiliation: _notNA(role['隶属']) || '',
                date_range: guest.custom_date || guest.date_range || '',
                purpose: guest.custom_purpose || guest.purpose || '',
                outcome: outcome,
                note: note,
                departure_darkfall: departureDarkfall,
                departure_appearance: departureAppearance,
                departure_personality: departurePersonality,
                departure_intimacy: departureIntimacy,
                departure_master_rel: departureMasterRel,
                roleCount: guest.roles ? guest.roles.length : 1,
                others: guest.others || '',
                roles: guest.roles ? guest.roles.map(function(r) {
                    var copy = {};
                    Object.keys(r).forEach(function(k) { if (k !== 'room') copy[k] = r[k]; });
                    return copy;
                }) : []
            });
            if (currentArchive.length > CONFIG.maxGuestLogEntries) {
                currentArchive = currentArchive.slice(-CONFIG.maxGuestLogEntries);
            }
            return currentArchive;
        }

        function refreshGuestLogPrompt(archive) {
            if (!archive || archive.length === 0) {
                if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.guestLogPromptId]);
                return;
            }
            var promptLimit = CONFIG.maxGuestLogPromptEntries || 8;
            var promptArchive = archive.length > promptLimit ? archive.slice(-promptLimit) : archive;
            var nums = '①②③④⑤⑥⑦⑧';
            var content = '<Guest_Log>\n来客簿：已离店的过往来访者记录(最近' + promptArchive.length + '组)。此处仅供回头客识别用，这些角色当前不在万事屋内。若同名角色再次到店，沿用此处记录的基本设定。\n';
            promptArchive.forEach(function(e, i) {
                var nameStr = e.name;
                var _t = (e.type && !/^n\/?\.?a\.?$/i.test(e.type.trim())) ? e.type : '';
                var _a = (e.affiliation && !/^n\/?\.?a\.?$/i.test(e.affiliation.trim())) ? e.affiliation : '';
                if (_t || _a) {
                    nameStr += '(' + [_t, _a].filter(Boolean).join('·') + ')';
                }
                if (e.roleCount > 1) {
                    nameStr += '+' + ((e.roleCount || 1) - 1) + '人';
                }
                if (e.others) {
                    nameStr += '+' + e.others;
                }
                content += (nums[i] || (i+1)+'.') + nameStr + '|' + e.date_range + '|' + e.purpose + '|' + e.outcome;
                if (e.note) content += '|' + e.note;
                if (e.departure_darkfall) content += '|离店暗堕:' + e.departure_darkfall;
                content += '\n';
            });
            content += '</Guest_Log>';
            if (typeof injectPrompts !== 'undefined') {
                injectPrompts([{
                    id: CONFIG.guestLogPromptId,
                    position: 'chat',
                    depth: CONFIG.guestLogDepth,
                    role: 'system',
                    content: content,
                    should_scan: false
                }]);
            }
        }

    // === 来客簿Tab渲染 ===
    function renderGuestLog(archive) {
        const $list = $('#th-list-guest');
        $list.empty();
        if (!archive || archive.length === 0) {
            $list.html('<div style="text-align:center; color:#888; margin-top:20px;">暂无来客记录<br><span style="font-size:10px;">来访者离店后会自动记录在此</span></div>');
            return;
        }
        var nums = '①②③④⑤⑥⑦⑧⑨⑩⑪⑫⑬⑭⑮⑯⑰⑱⑲⑳';
        var html = '';
        for (var i = archive.length - 1; i >= 0; i--) {
            var e = archive[i];
            var nameStr = e.name || '未知';
            if (_notNA(e.type) || _notNA(e.affiliation)) {
                nameStr += '<span style="opacity:0.7; font-size:11px;"> (' + [_notNA(e.type), _notNA(e.affiliation)].filter(Boolean).join('\u00b7') + ')</span>';
            }
            if (e.roleCount > 1) {
                nameStr += '<span style="opacity:0.6; font-size:10px;"> +' + ((e.roleCount || 1) - 1) + '人</span>';
            }
            if (e.others) {
                nameStr += '<span style="opacity:0.6; font-size:10px;"> +' + e.others + '</span>';
            }
            var outcomeColor = (e.outcome && e.outcome.indexOf('失败') >= 0) ? '#c44' : '#5a7a5a';
            html += '<div style="border-bottom:1px dashed rgba(160,110,80,0.2); padding:8px 4px; margin-bottom:4px;">';
            html += '<div style="font-size:13px; font-weight:700; color:var(--th-inv-text,#3A3226);">' + (nums[archive.length - 1 - i] || '') + ' ' + nameStr + '</div>';
            html += '<div style="font-size:11px; color:#666; margin-top:3px;">' + (e.date_range || '?') + ' | ' + (e.purpose || '?') + '</div>';
            html += '<div style="font-size:11px; color:' + outcomeColor + '; margin-top:2px;">\u2192 ' + (e.outcome || '已离店') + '</div>';
            if (e.note) {
                html += '<div style="font-size:10px; color:#888; font-style:italic; margin-top:2px;">\u201c' + e.note + '\u201d</div>';
            }
            html += '</div>';
        }
        $list.html(html);
        parseEmoji($list[0]);
    }

        function refreshGuestPrompt(guestList, archive) {
        // 如果没人，清除 Prompt
        if (!guestList || guestList.length === 0) {
            if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.guestPromptId]);
            return;
        }

        // 构建 archive 索引：normalize(name)+'|'+normalize(affiliation) → [entries]
        const archiveIndex = {};
        if (archive && archive.length > 0) {
            archive.forEach(function(entry) {
                if (!entry.roles || entry.roles.length === 0) {
                    // 无角色详情时用顶层 name+affiliation
                    const aName = normalize(entry.name || '');
                    const aAff = normalize(entry.affiliation || '');
                    if (aName) {
                        const key = aName + '|' + aAff;
                        if (!archiveIndex[key]) archiveIndex[key] = [];
                        archiveIndex[key].push(entry);
                    }
                } else {
                    entry.roles.forEach(function(r) {
                        const aName = normalize(r['姓名'] || r['Name'] || '');
                        const aAff = normalize(r['隶属'] || '');
                        if (aName) {
                            const key = aName + '|' + aAff;
                            if (!archiveIndex[key]) archiveIndex[key] = [];
                            archiveIndex[key].push(entry);
                        }
                    });
                }
            });
        }

        let content = `<Current_Guest_Group_Info>\n`;
        content += `此处记录了当前正在万事屋内的来访者团体信息。若信息有更新，请以最新信息为准。\n`;

        guestList.forEach((g, i) => {
            // --- 1. 优先使用手动修改的数据 ---
            const displayDate = g.custom_date || g.date_range || "未知日期";
            const displayPurpose = g.custom_purpose || g.purpose || "未知目的";

            // --- 2. 整合备注与欠费 ---
            let statusParts = [];
            if (g.note) statusParts.push(`备注: ${g.note}`);
            if (g.pending_payment && g.pending_payment != "0") statusParts.push(`待支付: ${g.pending_payment}`);

            const statusStr = statusParts.length > 0 ? ` [${statusParts.join(' | ')}]` : "";

            content += `\n【团体 ${i + 1}】\n`;
            content += `时间: ${displayDate}\n`;
            content += `事由: ${displayPurpose}${statusStr}\n`;

            // --- 3. 角色详情 ---
            if (g.roles && g.roles.length > 0) {
                content += `成员:\n`;
                g.roles.forEach(r => {
                    const rName = r['姓名'] || r['Name'] || "未知角色";
                    const rRoom = r.room ? `房号:${r.room}` : "未分配房间";

                    let attrs = [];
                    attrs.push(`姓名:${rName}`);
                    if (r['隶属']) attrs.push(`隶属:${r['隶属']}`);
                    if (r['刀种'] && _notNA(r['刀种'])) attrs.push(`刀种:${r['刀种']}`);
                    if (r['性别']) attrs.push(`性别:${r['性别']}`);
                    if (r['职业'] && _notNA(r['职业'])) attrs.push(`职业:${r['职业']}`);
                    if (r['来访身份']) attrs.push(`来访身份:${r['来访身份']}`);
                    if (r['性取向'] && _notNA(r['性取向'])) attrs.push(`性取向:${r['性取向']}`);
                    if (r['刀主关系'] && _notNA(r['刀主关系'])) attrs.push(`刀主关系:${r['刀主关系']}`);
                    if (r['本丸职责'] && _notNA(r['本丸职责'])) attrs.push(`本丸职责:${r['本丸职责']}`);
                    if (r['刀主灰度'] && _notNA(r['刀主灰度'])) attrs.push(`刀主灰度:${r['刀主灰度']}`);
                    if (r['统御风格'] && _notNA(r['统御风格'])) attrs.push(`统御风格:${r['统御风格']}`);
                    if (r['本丸状况'] && _notNA(r['本丸状况'])) attrs.push(`本丸状况:${r['本丸状况']}`);
                    if (r['身份认同'] && _notNA(r['身份认同'])) attrs.push(`身份认同:${r['身份认同']}`);
                    if (r['性格概述']) attrs.push(`性格概述:${r['性格概述']}`);
                    if (r['暗堕关联']) attrs.push(`暗堕关联:${r['暗堕关联']}`);
                    if (r['亲密倾向'] && _notNA(r['亲密倾向'])) attrs.push(`亲密倾向:${r['亲密倾向']}`);
                    attrs.push(rRoom);
                    const appearance = r['外形描写'] || "";

                    content += `  【${attrs.join('|')}】\n`;
                    if (appearance) {
                        content += `    外形描写:${appearance}\n`;
                    }
                });
            }

            // --- 4. 其他背景板 ---
            if (g.others) {
                const oRoom = g.others_room ? ` (房号:${g.others_room})` : "";
                content += `  + 其他随行人员: ${g.others}${oRoom}\n`;
            }

            // --- 5. 回头客档案：检查当前团体角色是否匹配 archive ---
            if (g.roles && Object.keys(archiveIndex).length > 0) {
                let matchedEntries = [];
                let matchedKeys = new Set();
                g.roles.forEach(r => {
                    const rName = normalize(r['姓名'] || r['Name'] || '');
                    const rAff = normalize(r['隶属'] || '');
                    if (rName) {
                        const key = rName + '|' + rAff;
                        if (archiveIndex[key] && !matchedKeys.has(key)) {
                            matchedKeys.add(key);
                            archiveIndex[key].forEach(e => matchedEntries.push(e));
                        }
                    }
                });
                if (matchedEntries.length > 0) {
                    content += `  📋回头客档案(过往来访记录，该角色当前在店内):\n`;
                    matchedEntries.forEach(e => {
                        let line = `    ${e.name}`;
                        if (_notNA(e.type) || _notNA(e.affiliation)) line += `(${[_notNA(e.type), _notNA(e.affiliation)].filter(Boolean).join('·')})`;
                        line += `|${e.date_range}|${e.purpose}|${e.outcome}`;
                        if (e.note) line += `|${e.note}`;
                        if (e.departure_darkfall) line += `|离店暗堕:${e.departure_darkfall}`;
                        content += line + `\n`;
                        let details = [];
                        if (e.departure_appearance && e.departure_appearance !== '同来时') details.push(`外形:${e.departure_appearance}`);
                        if (e.departure_personality && e.departure_personality !== '同来时') details.push(`性格:${e.departure_personality}`);
                        if (e.departure_intimacy) details.push(`亲密:${e.departure_intimacy}`);
                        if (e.departure_master_rel) details.push(`与主人关系:${e.departure_master_rel}`);
                        if (details.length > 0) content += `      离店状态→${details.join('|')}\n`;
                    });
                }
            }
        });

        content += `\n</Current_Guest_Group_Info>`;

        const injection = {
            id: CONFIG.guestPromptId || 'th_guest_info_prompt',
            position: 'chat',
            depth: CONFIG.guestPromptDepth || 3,
            role: 'system',
            content: content,
            should_scan: true
        };

        if (typeof injectPrompts !== 'undefined') injectPrompts([injection]);
    }

    function refreshPricePrompt(listData = null, slotsData = null) {
        if (!listData) listData = getPriceData();
        if (!slotsData) slotsData = getPriceSlotsData();

        let boardLines = [];

        const count = listData.length - 1;
        for (let i = 0; i < count; i++) {
            if (listData[i] && listData[i].name && listData[i].price) {
                boardLines.push(`${listData[i].name}-${listData[i].price}`);
            }
        }

        const noteObj = listData[listData.length - 1];
        if (noteObj) {
            const noteContent = noteObj.note ? `(${noteObj.note})` : '';
            boardLines.push(`主人特别慰藉${noteContent}-面议`);
        }

        // 货架商品：独立区块，放在主人特别慰藉后面
        const fullInventory = getVars()[CONFIG.varDataKey] || [];
        let shelfLines = [];
        slotsData.forEach(slot => {
            if (slot.id) {
                const item = fullInventory.find(it => it.id === slot.id);
                if (item) {
                    const priceStr = slot.price ? slot.price : "定价待定";
                    const descStr = item.desc ? `(${item.desc})` : '';
                    shelfLines.push(`${item.name}${descStr}-${priceStr}`);
                }
            }
        });

        // 公告板内容
        const noticeText = getVars()[CONFIG.varNoticeKey] || '';

        if (boardLines.length === 0 && shelfLines.length === 0 && !noticeText) {
            if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.pricePromptId]);
            return;
        }

        let promptContent = `\n<Tavern_Tariff>\n`;
        if (boardLines.length > 0) {
            promptContent += `[万事屋价目板]\n${boardLines.join('\n')}\n`;
        }
        if (shelfLines.length > 0) {
            promptContent += `[万事屋商品架]\n${shelfLines.join('\n')}\n`;
        }
        if (noticeText) {
            promptContent += `[公告板]\n${noticeText}\n`;
        }
        promptContent += `</Tavern_Tariff>\n`;

        if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.pricePromptId]);
        const injection = { id: CONFIG.pricePromptId, position: 'in_chat', depth: CONFIG.priceBoardDepth, role: 'system', content: promptContent, should_scan: true };
        if (typeof injectPrompts !== 'undefined') injectPrompts([injection]);
    }

    function onPriceInputChange() {
        const $input = $(this);
        const val = $input.val();
        const placeholder = $input.attr('placeholder');

        if ($input.hasClass('th-price-input')) {
            let $measure = $('#th-input-measure');
            if ($measure.length === 0) {
                $measure = $('<span id="th-input-measure"></span>').css({
                    position: 'absolute', visibility: 'hidden', whiteSpace: 'pre',
                    fontSize: '14px', fontWeight: 'bold', fontFamily: 'inherit'
                });
                $measure.appendTo('#' + CONFIG.domPanelId);
            }
            $measure.text(val || placeholder || '____');
            const width = $measure.width() + 12;
            $input.css('width', width + 'px');
        }

        if (!isInitializingPriceBoard) {
            if (priceSaveTimer) clearTimeout(priceSaveTimer);
            priceSaveTimer = setTimeout(() => { savePriceData(); }, 1000);
        }
    }

    function moveToStorage(id) {
        const storageList = getVars()[CONFIG.varStorageKey] || [];
        if (!storageList.includes(id)) {
            storageList.push(id);
            if (typeof TavernHelper !== 'undefined') {
                TavernHelper.insertOrAssignVariables({ [CONFIG.varStorageKey]: storageList }, { type: 'chat' });
            }
            // if(window.toastr) toastr.success('放入杂物间', '系统');
            performScan();
        }
    }

    function retrieveFromStorage(id) {
        let storageList = getVars()[CONFIG.varStorageKey] || [];
        storageList = storageList.filter(sid => sid !== id);
        if (typeof TavernHelper !== 'undefined') {
            TavernHelper.insertOrAssignVariables({ [CONFIG.varStorageKey]: storageList }, { type: 'chat' });
        }
        // if(window.toastr) toastr.success('物品已取出', '系统');
        closeDetailPopup();
        performScan();
    }

    function moveStorageToStaff(itemId, staffName) {
        let storageList = getVars()[CONFIG.varStorageKey] || [];
        let staffMap = getVars()[CONFIG.varStaffItemsKey] || {};
        storageList = storageList.filter(sid => sid !== itemId);
        if (!staffMap[staffName]) staffMap[staffName] = [];
        if (!staffMap[staffName].includes(itemId)) {
            if (staffMap[staffName].length >= 2) {
                if(window.toastr) toastr.warning(`${staffName} 手里拿不下了`, '系统');
                return;
            }
            staffMap[staffName].push(itemId);
        }
        if (typeof TavernHelper !== 'undefined') {
            TavernHelper.insertOrAssignVariables({ [CONFIG.varStorageKey]: storageList, [CONFIG.varStaffItemsKey]: staffMap }, { type: 'chat' });
        }
        // if(window.toastr) toastr.success(`物品已分配给 ${staffName}`, '系统');
        performScan();
    }

    function moveStaffToStorage(itemId, staffName) {
        let storageList = getVars()[CONFIG.varStorageKey] || [];
        let staffMap = getVars()[CONFIG.varStaffItemsKey] || {};
        if (staffMap[staffName]) staffMap[staffName] = staffMap[staffName].filter(sid => sid !== itemId);
        if (!storageList.includes(itemId)) storageList.push(itemId);
        if (typeof TavernHelper !== 'undefined') {
            TavernHelper.insertOrAssignVariables({ [CONFIG.varStorageKey]: storageList, [CONFIG.varStaffItemsKey]: staffMap }, { type: 'chat' });
        }
        //if(window.toastr) toastr.success('物品已收回杂物间', '系统');
        performScan();
    }

    function moveItemToPriceSlot(itemId, slotIndex, sourceSlotIndex = null) {
        let slotsData = getPriceSlotsData();
        let storageList = getVars()[CONFIG.varStorageKey] || [];

        // 目标槽有其他物品时，把它退回杂物间
        if (slotsData[slotIndex].id && slotsData[slotIndex].id !== itemId) {
            storageList.push(slotsData[slotIndex].id);
        }

        // 货架→货架搬移：清除来源槽，防止物品"分身"
        if (sourceSlotIndex !== null && sourceSlotIndex !== slotIndex) {
            slotsData[sourceSlotIndex].id = null;
            slotsData[sourceSlotIndex].price = "";
        }

        slotsData[slotIndex].id = itemId;

        storageList = storageList.filter(sid => sid !== itemId);

        if (typeof TavernHelper !== 'undefined') {
            TavernHelper.insertOrAssignVariables({
                [CONFIG.varPriceSlotsKey]: slotsData,
                [CONFIG.varStorageKey]: storageList
            }, { type: 'chat' });
        }

        //if(window.toastr) toastr.success('物品已上架', '系统');
        performScan();
    }

    function removeItemFromPriceSlot(slotIndex) {
        let slotsData = getPriceSlotsData();
        let storageList = getVars()[CONFIG.varStorageKey] || [];

        const itemId = slotsData[slotIndex].id;
        if (!itemId) return;

        slotsData[slotIndex].id = null;
        slotsData[slotIndex].price = "";

        if (!storageList.includes(itemId)) storageList.push(itemId);

        if (typeof TavernHelper !== 'undefined') {
            TavernHelper.insertOrAssignVariables({
                [CONFIG.varPriceSlotsKey]: slotsData,
                [CONFIG.varStorageKey]: storageList
            }, { type: 'chat' });
        }

        //if(window.toastr) toastr.success('物品已下架', '系统');
        performScan();
    }

    async function appendUpdateToChat(text, successMsg) {
        try {
            const messages = getChatMessages('0-{{lastMessageId}}');
            let targetMsg = null;
            for (let i = messages.length - 1; i >= 0; i--) { if (messages[i].role === 'assistant') { targetMsg = messages[i]; break; } }
            if (targetMsg) {
                await setChatMessages([{ message_id: targetMsg.message_id, message: targetMsg.message + "\n" + text }], { refresh: 'affected' });
                if(window.toastr) toastr.success(successMsg, '系统');
                closeDetailPopup();
                closeEditPopup();
                performScan();
            }
        } catch (e) { console.error(e); }
    }

    async function deleteItemAction(id, name) {
        if (!confirm(`🗑️ 确定要丢弃 [${name}] 吗？`)) return;
        const deleteCommand = `<Item>\nCMD:DEL | ${id}\n</Item>`;
        await appendUpdateToChat(deleteCommand, `已丢弃 ${name}`);
    }

    function openEditPopup(title, content, onSave) {
        const $popup = $('#' + CONFIG.domEditId);
        if ($popup.length === 0) return;

        $popup.find('.edit-title').text(title);
        $popup.find('textarea').val(content);

        $popup.find('.save-btn').off('click').on('click', () => {
            const newContent = $popup.find('textarea').val();
            onSave(newContent);
        });

        $popup.css('display', 'flex').hide().fadeIn(150);
    }

    function closeEditPopup() { $('#' + CONFIG.domEditId).fadeOut(150); }

    function editItemAction(item) {
        const template = `<Item>\nCMD:MOD | ${item.id} | ${item.icon} | ${item.name} | ${item.desc || '新描述'}\n</Item>`;
        openEditPopup(`编辑道具: ${item.name}`, template, (newText) => {
            appendUpdateToChat(newText, "道具修改指令已发送");
        });
    }

    function editStaffAction(staffName, staffData) {
        let contentStr = '';
        for (const [key, value] of Object.entries(staffData)) {
            if (key === '_items') continue;
            contentStr += `${key}：${value} | `;
        }
        if (contentStr.endsWith(' | ')) contentStr = contentStr.slice(0, -3);

        const template = `<New_Employee_Profile>\n【${contentStr}】\n</New_Employee_Profile>`;

        openEditPopup(`编辑员工: ${staffName}`, template, (newText) => {
            appendUpdateToChat(newText, "员工信息修改已发送");
        });
    }

    async function deleteStaffAction(staffName) {
        if (!confirm(`🗑️ 确定要解雇 [${staffName}] 吗？`)) return;
        const deleteCommand = `<Employee>\nCMD:DEL_STAFF | ${staffName}\n</Employee>`;
        await appendUpdateToChat(deleteCommand, `已解雇 ${staffName}`);
    }

    // =================================================================
    // === 核心扫描逻辑 ===
    // mode: 'full'（全量，用于删改楼） | 'incremental'（增量，仅新消息）
    // forceCheckpoint: true 时强制在扫描后保存检查点（手动建立检查点时使用）
    // =================================================================
    function performScan(mode, forceCheckpoint) {
        if (mode === undefined) mode = 'full';
        if (forceCheckpoint === undefined) forceCheckpoint = false;

        let allMessages;
        if (typeof getChatMessages !== 'undefined') allMessages = getChatMessages('0-{{lastMessageId}}');
        else if (typeof TavernHelper !== 'undefined') allMessages = TavernHelper.getChatMessages('0-{{lastMessageId}}');
        if (!allMessages) return;

        // ---- 增量扫描：确定起点，并从检查点恢复初始状态 ----
        let scanFromIndex = 0;
        let checkpoint = null;

        let maxId = getMaxId();
        const dbMap = getDbMap();
        let currentInventory = [];
        const usedMapKeys = new Set();
        const achievementMap = new Map();
        const staffMap = new Map();
        let renovationList = [];
        currentWorldDate = "";

        if (mode === 'incremental') {
            checkpoint = getCheckpoint();
            if (checkpoint && checkpoint.message_id != null) {
                // 找到检查点之后第一条消息的下标
                const cpMsgId = checkpoint.message_id;
                scanFromIndex = allMessages.findIndex(m => m.message_id > cpMsgId);
                if (scanFromIndex === -1) scanFromIndex = allMessages.length; // 没有新消息

                // 从检查点恢复状态
                maxId = checkpoint.maxId || 0;
                Object.assign(dbMap, checkpoint.dbMap || {});
                // 把检查点里所有 dbMap 的 key 都标记为"使用中"，防止被清理
                Object.keys(checkpoint.dbMap || {}).forEach(k => usedMapKeys.add(k));
                if (checkpoint.inventory) currentInventory = [...checkpoint.inventory];
                if (checkpoint.achievements) checkpoint.achievements.forEach(a => achievementMap.set(a.name, a));
                if (checkpoint.staff) checkpoint.staff.forEach(s => {
                    const name = s['姓名'] || s['Name'] || s['name'];
                    if (name) staffMap.set(name, s);
                });
                if (checkpoint.renovationList) renovationList = [...checkpoint.renovationList];
                if (checkpoint.worldDate) currentWorldDate = checkpoint.worldDate;
            } else {
                // 没有检查点，退化为全量扫描
                mode = 'full';
                scanFromIndex = 0;
            }
        }

        // 全量扫描 + 导入基准：若存在 is_import_base 检查点，以导入数据为初始状态
        // 这确保即使聊天记录里没有 CMD:ADD，导入的物品也不会被全量扫描清零
        if (mode === 'full') {
            // 读取独立存储的导入基准（删楼触发的 clearCheckpoint 不会清掉它）
            let _importBase = null;
            try { if (typeof TavernHelper !== 'undefined') _importBase = TavernHelper.getVariables({ type: 'chat' })[CONFIG.varImportBaseKey] || null; } catch(e) {}
            if (_importBase) {
                currentInventory = [...(_importBase.inventory || [])];
                maxId = _importBase.maxId || maxId;
                Object.assign(dbMap, _importBase.dbMap || {});
                Object.keys(_importBase.dbMap || {}).forEach(k => usedMapKeys.add(k));
                if (_importBase.achievements) _importBase.achievements.forEach(a => achievementMap.set(a.name, a));
                if (_importBase.staff) _importBase.staff.forEach(s => { const n = s['姓名']||s['Name']||s['name']; if(n) staffMap.set(n, s); });
                if (_importBase.renovationList) renovationList = [...(_importBase.renovationList)];
            }
        }

        // --- 1. 建立历史档案（保存用户手动编辑的来访者数据，如备注、欠费等）---
        let historicalMap = {};
        let cleanIdMap = {};

        if (typeof TavernHelper !== 'undefined') {
            const currentVars = TavernHelper.getVariables({ type: 'chat' });
            const savedGuests = currentVars[CONFIG.varGuestKey];
            let listToLoad = [];
            if (Array.isArray(savedGuests)) listToLoad = savedGuests;
            else if (savedGuests && typeof savedGuests === 'object') listToLoad = [savedGuests];

            listToLoad.forEach(g => {
                const rawId = getGuestGroupID(g);
                historicalMap[rawId] = g;
                cleanIdMap[normalize(rawId)] = g;
            });
        }

        // 增量模式：以检查点快照的来访者状态为起点，再用最新手动编辑覆盖一遍
        let activeGuestBook = {};
        if (mode === 'incremental' && checkpoint && checkpoint.activeGuestBook) {
            Object.entries(checkpoint.activeGuestBook).forEach(([id, guest]) => {
                // 用最新 historicalMap 中的手动编辑数据覆盖（防止检查点建立后用户又手动改了）
                const savedGuest = historicalMap[id] || cleanIdMap[normalize(id)];
                if (savedGuest) {
                    guest.pending_payment = savedGuest.pending_payment;
                    guest.note = savedGuest.note || "";
                    guest.others_room = savedGuest.others_room || "";
                    guest.custom_date = savedGuest.custom_date;
                    guest.custom_purpose = savedGuest.custom_purpose;
                    if (savedGuest.roles && guest.roles) {
                        const savedRolesMap = {};
                        savedGuest.roles.forEach(r => { const n = r['姓名'] || r['Name']; if (n) savedRolesMap[normalize(n)] = r; });
                        guest.roles.forEach(nr => { const n = nr['姓名'] || nr['Name']; if (n && savedRolesMap[normalize(n)]) nr.room = savedRolesMap[normalize(n)].room || ""; });
                    }
                }
                activeGuestBook[id] = guest;
            });
        }

        // 来客簿归档（全量扫描时重置，防止重复归档；增量扫描时继承已有数据）
        var guestLogArchive = (mode === 'full') ? [] : (getVars()[CONFIG.varGuestLogKey] || []);

        // --- 2. 扫描循环（增量模式只扫 scanFromIndex 之后的消息）---
        const messagesToScan = mode === 'incremental' ? allMessages.slice(scanFromIndex) : allMessages;
        for (const msg of messagesToScan) {
            const text = msg.message || msg.mes || "";
            if (!text) continue;

            // 追踪当前世界日期
            if (text.includes('[STATUS]')) {
                const dateMatch = text.match(CONFIG.regexStatusDate);
                if (dateMatch && dateMatch[1]) currentWorldDate = dateMatch[1].trim();
            }

            // 扫描基建修缮记录
            if (text.includes('修缮')) {
                CONFIG.regexRenovation.lastIndex = 0;
                for (const m of text.matchAll(CONFIG.regexRenovation)) {
                    renovationList.push({
                      date: currentWorldDate || "未知日期",
    cost: m[1],
    detail: m[2].replace(/。\s*$/, "").trim()
                    });
                }
            }

            const foundGuests = parseGuestData(text);
foundGuests.forEach(foundGuest => {
    const rawId = getGuestGroupID(foundGuest);
    const cleanId = normalize(rawId);

    // --- 去重保护：基于姓名+隶属匹配，防止同一客人被重复记录或属性被覆盖 ---
    // 同名刀可能来自不同本丸，因此需要姓名+隶属共同判定
    const newIdentities = new Set();
    if (foundGuest.roles) {
        foundGuest.roles.forEach(r => {
            const n = normalize(r['姓名'] || r['Name'] || '');
            const a = normalize(r['隶属'] || '');
            if (n) newIdentities.add(n + '|' + a);
        });
    }

    // 检查是否有不同 ID 但同一角色（姓名+隶属）的记录（日期格式变化等）
    let existingKey = null;
    if (newIdentities.size > 0) {
        Object.keys(activeGuestBook).forEach(k => {
            if (k === rawId || normalize(k) === cleanId) return;
            const existing = activeGuestBook[k];
            if (existing.roles) {
                for (const r of existing.roles) {
                    const eName = normalize(r['姓名'] || r['Name'] || '');
                    const eAff = normalize(r['隶属'] || '');
                    if (eName && newIdentities.has(eName + '|' + eAff)) { existingKey = k; return; }
                }
            }
        });
    }

    if (existingKey) {
        const _existGuest = activeGuestBook[existingKey];
        if (_existGuest && _existGuest.pending_departure) {
            guestLogArchive = archiveGuest(_existGuest, _existGuest._departure_text || '', guestLogArchive);
            delete activeGuestBook[existingKey];
        } else {
            return;
        }
    }

    // 同 ID 已存在 → 保留首次角色属性，只同步用户编辑
    let oldData = historicalMap[rawId] || cleanIdMap[cleanId];
    const existingSameId = activeGuestBook[rawId] || activeGuestBook[Object.keys(activeGuestBook).find(k => normalize(k) === cleanId)];

    if (existingSameId) {
        if (existingSameId.pending_departure) {
            guestLogArchive = archiveGuest(existingSameId, existingSameId._departure_text || '', guestLogArchive);
            const _sameKey = Object.keys(activeGuestBook).find(k => k === rawId || normalize(k) === cleanId);
            if (_sameKey) delete activeGuestBook[_sameKey];
        } else {
        if (oldData) {
            existingSameId.pending_payment = oldData.pending_payment;
            existingSameId.note = oldData.note || "";
            existingSameId.others_room = oldData.others_room || "";
            existingSameId.custom_date = oldData.custom_date;
            existingSameId.custom_purpose = oldData.custom_purpose;
            if (oldData.roles && existingSameId.roles) {
                const savedRolesMap = {};
                oldData.roles.forEach(r => { const n = r['姓名'] || r['Name']; if (n) savedRolesMap[normalize(n)] = r; });
                existingSameId.roles.forEach(nr => {
                    const nn = normalize(nr['姓名'] || nr['Name'] || '');
                    if (nn && savedRolesMap[nn]) nr.room = savedRolesMap[nn].room || "";
                });
            }
        }
        return; // 不覆盖，保留首次数据
    }
    }

    // 全新客人：正常写入
    if (oldData) {
        foundGuest.pending_payment = oldData.pending_payment;
        foundGuest.note = oldData.note || "";
        foundGuest.others_room = oldData.others_room || "";
        foundGuest.custom_date = oldData.custom_date;
        foundGuest.custom_purpose = oldData.custom_purpose;

        const oldRolesMap = {};
        if (oldData.roles && Array.isArray(oldData.roles)) {
            oldData.roles.forEach(r => {
                const rName = r['姓名'] || r['Name'];
                if (rName) oldRolesMap[normalize(rName)] = r;
            });
        }
        if (foundGuest.roles && Array.isArray(foundGuest.roles)) {
            foundGuest.roles.forEach(newRole => {
                const newName = newRole['姓名'] || newRole['Name'];
                const cleanName = normalize(newName);
                if (cleanName && oldRolesMap[cleanName]) {
                    newRole.room = oldRolesMap[cleanName].room || "";
                }
            });
        }
    }
    foundGuest._just_added = true;
    activeGuestBook[rawId] = foundGuest;
});

            // 来客簿归档：guestLogArchive 已在循环外初始化，此处直接使用
            // 删除指令
            if (text.includes('CMD:DEL_GUEST')) {
                CONFIG.regexGuestDel.lastIndex = 0;
                for (const m of text.matchAll(CONFIG.regexGuestDel)) {
                    const targetId = m[1].trim();
                    if (targetId) {
                        if(activeGuestBook[targetId]) { guestLogArchive = archiveGuest(activeGuestBook[targetId], text, guestLogArchive); delete activeGuestBook[targetId]; }
                        else {
                            const cleanTarget = normalize(targetId);
                            Object.keys(activeGuestBook).forEach(k => {
                                if(normalize(k) === cleanTarget) { guestLogArchive = archiveGuest(activeGuestBook[k], text, guestLogArchive); delete activeGuestBook[k]; }
                            });
                        }
                    }
                }
            }
            // <Guest_Departure> 延迟离店标记（支持多人同时离店 + normalize匹配）
            if (text.includes('<Guest_Departure>')) {
                var _depRegex = /<Guest_Departure>\s*(.*?)\s*<\/Guest_Departure>/gi;
                var _depMatch;
                while ((_depMatch = _depRegex.exec(text)) !== null) {
                    var _depName = _depMatch[1].split('|')[0].trim();
                    if (!_depName) continue;
                    var _depNameClean = normalize(_depName);
                    Object.keys(activeGuestBook).forEach(function(k) {
                        var g = activeGuestBook[k];
                        if (g.roles && Array.isArray(g.roles)) {
                            for (var _ri = 0; _ri < g.roles.length; _ri++) {
                                var gn = g.roles[_ri]['姓名'] || g.roles[_ri]['Name'] || '';
                                if (normalize(gn) === _depNameClean) { if (!g._just_added) { g.pending_departure = true; g._departure_text = text; } break; }
                            }
                        }
                    });
                }
            }
            // 清除本轮新增标记
            Object.values(activeGuestBook).forEach(function(g) { delete g._just_added; });
            // (物品、成就等逻辑保持不变，为节省篇幅略去...)
            if (text.includes('CMD:ADD')) { CONFIG.regexLineAdd.lastIndex = 0; for (const m of [...text.matchAll(CONFIG.regexLineAdd)]) { let parts = smartParse(m[1]); if (parts.length > 0 && /^\d+$/.test(parts[0])) parts.shift(); if (parts.length >= 2) { if (/[金银铜]币|混合货币/.test(parts[1])) continue; const uniqueKey = `${msg.message_id}_add_${usedMapKeys.size}`; usedMapKeys.add(uniqueKey); let assignedId = dbMap[uniqueKey] || String(++maxId).padStart(3, '0'); dbMap[uniqueKey] = assignedId; currentInventory.push({ id: assignedId, icon: parts[0], name: parts[1], desc: parts.length >= 3 ? parts[2] : "" }); } } }
            if (text.includes('CMD:MOD')) { CONFIG.regexLineMod.lastIndex = 0; for (const m of text.matchAll(CONFIG.regexLineMod)) { const parts = smartParse(m[1]); if (parts.length >= 3) { const idx = currentInventory.findIndex(x => x.id === parts[0]); if (idx !== -1) { currentInventory[idx].icon = parts[1]; currentInventory[idx].name = parts[2]; if (parts.length >= 4) currentInventory[idx].desc = parts[3]; } } } }
            if (text.includes('CMD:DEL')) { CONFIG.regexLineDel.lastIndex = 0; for (const m of text.matchAll(CONFIG.regexLineDel)) { const parts = smartParse(m[1]); if (parts.length >= 1) currentInventory = currentInventory.filter(x => x.id !== parts[0]); } }
            if (text.includes('成就')) { CONFIG.regexAchievement.lastIndex = 0; for (const m of text.matchAll(CONFIG.regexAchievement)) { achievementMap.set(m[2].trim(), { icon: m[1].trim(), name: m[2].trim(), condition: m[3].trim(), reward: m[4].trim(), eval: m[5].trim() }); } }
            if (text.match(/<New_Employee_Profile>/i)) { CONFIG.regexStaffBlock.lastIndex = 0; for (const blockMatch of text.matchAll(CONFIG.regexStaffBlock)) { const innerContent = blockMatch[1]; if (!innerContent) continue; let staffObj = {}; CONFIG.regexStaffKV.lastIndex = 0; for (const kvMatch of innerContent.matchAll(CONFIG.regexStaffKV)) { staffObj[kvMatch[1].trim()] = kvMatch[2].trim(); } let name = staffObj['姓名'] || staffObj['Name'] || staffObj['name']; if (name) staffMap.set(name, staffObj); } }
            if (text.includes('CMD:DEL_STAFF')) {
                CONFIG.regexStaffDel.lastIndex = 0;
                for (const m of text.matchAll(CONFIG.regexStaffDel)) {
                    const targetName = m[1].trim();
                    if (targetName) {
                        staffMap.delete(targetName);
                    }
                }
            }
        }

        // 价目板初始化扫描（仅当变量为空时从标签初始化）
        let scannedPriceData = null;
        for (let mi = 0; mi < allMessages.length; mi++) {
            const pText = allMessages[mi].message || allMessages[mi].mes || '';
            const priceMatch = pText.match(CONFIG.regexPriceBoard);
            if (priceMatch) {
                const lines = priceMatch[1].trim().split('\n').filter(l => l.trim());
                const priceList = [];
                lines.forEach(line => {
                    const parts = line.split('-');
                    if (parts.length >= 2) {
                        priceList.push({ name: parts[0].trim(), price: parts.slice(1).join('-').trim() });
                    }
                });
                if (priceList.length > 0) {
                    priceList.push({ note: "" });
                    scannedPriceData = priceList;
                }
                break;
            }
        }

        // 3. 保存与渲染
        const newDbMap = {}; Object.keys(dbMap).forEach(key => { if (usedMapKeys.has(key)) newDbMap[key] = dbMap[key]; });
        const currentAchievements = Array.from(achievementMap.values());
        const currentStaff = Array.from(staffMap.values());

        let staffItemsMap = getVars()[CONFIG.varStaffItemsKey] || {};
        let isStaffMapDirty = false;
        for (const [staffName, heldIds] of Object.entries(staffItemsMap)) {
            const validIds = heldIds.filter(id => currentInventory.some(item => item.id === id));
            if (validIds.length !== heldIds.length) { staffItemsMap[staffName] = validIds; isStaffMapDirty = true; }
        }
        if (isStaffMapDirty && typeof TavernHelper !== 'undefined') TavernHelper.insertOrAssignVariables({ [CONFIG.varStaffItemsKey]: staffItemsMap }, { type: 'chat' });

        let priceSlotsData = getPriceSlotsData();
        let isSlotsDirty = false;
        priceSlotsData.forEach(slot => { if (slot.id && !currentInventory.some(item => item.id === slot.id)) { slot.id = null; slot.price = ""; isSlotsDirty = true; } });

        // --- 立即处理离店归档（不再延迟到下一轮）---
        Object.keys(activeGuestBook).forEach(function(k) {
            var g = activeGuestBook[k];
            if (g.pending_departure) {
                guestLogArchive = archiveGuest(g, g._departure_text || '', guestLogArchive);
                delete activeGuestBook[k];
            }
        });

        const guestListToSave = Object.values(activeGuestBook);

        if (typeof TavernHelper !== 'undefined') {
            let varsToSave = {
                [CONFIG.varDataKey]: currentInventory,
                [CONFIG.varMapKey]: newDbMap,
                [CONFIG.varMaxIdKey]: maxId,
                [CONFIG.varAchieveKey]: currentAchievements,
                [CONFIG.varGuestKey]: guestListToSave,
                [CONFIG.varGuestLogKey]: guestLogArchive,
                [CONFIG.varRenoKey]: renovationList, // 保存基建记录
                [CONFIG.varStaffKey]: currentStaff   // 【新增】保存员工数据，供Tab切换时直接读取
            };
            if (isSlotsDirty) varsToSave[CONFIG.varPriceSlotsKey] = priceSlotsData;

            TavernHelper.insertOrAssignVariables(varsToSave, { type: 'chat' });

            // 价目板初始化：仅当变量为空时写入扫描到的数据
            if (scannedPriceData) {
                const existingPrice = getVars()[CONFIG.varPriceKey];
                if (!Array.isArray(existingPrice) || existingPrice.length === 0 || existingPrice.every(item => !item.name && !item.note)) {
                    TavernHelper.insertOrAssignVariables({ [CONFIG.varPriceKey]: scannedPriceData }, { type: 'chat' });
                    refreshPricePrompt(scannedPriceData);
                    dirtyTabs.add('price');
                }
            }

            refreshGuestPrompt(guestListToSave, guestLogArchive);
            if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.guestLogPromptId]);
            checkDeparturePrompt(guestListToSave);
        }

        // === 脏标记：标记所有 Tab 数据已更新，等待按需渲染 ===
        ['inventory', 'staff', 'achievement', 'price', 'infra', 'guest'].forEach(t => dirtyTabs.add(t));

        if (isPanelOpen) renderActiveTab();
        if (isStorageOpen) renderStorageItems();

        // === 自动检查点：全量扫描完成后，视情况更新检查点 ===
        if (mode === 'full') {
            const latestMsg = allMessages.length > 0 ? allMessages[allMessages.length - 1] : null;
            const latestMsgId = latestMsg ? latestMsg.message_id : 0;
            const existingCp = getCheckpoint();
            const lastCpId = existingCp ? (existingCp.message_id || 0) : 0;
            if (forceCheckpoint || (latestMsgId - lastCpId >= CONFIG.checkpointInterval)) {
                saveCheckpoint({
                    message_id: latestMsgId,
                    maxId: maxId,
                    dbMap: newDbMap,
                    inventory: currentInventory,
                    achievements: currentAchievements,
                    staff: currentStaff,
                    activeGuestBook: activeGuestBook,
                    renovationList: renovationList,
                    worldDate: currentWorldDate
                });
                if (forceCheckpoint && window.toastr) toastr.success(`检查点已建立（截至第 ${latestMsgId} 楼）`, '系统');
                // 导入基准已被真实检查点接管，清除它避免重复叠加
                try { if (typeof TavernHelper !== 'undefined') TavernHelper.insertOrAssignVariables({ [CONFIG.varImportBaseKey]: null }, { type: 'chat' }); } catch(e) {}
            }
        }

        // 注入基建Prompt
        refreshInfraPrompt(renovationList);

        let storageList = getVars()[CONFIG.varStorageKey] || [];
        const _validStorage = storageList.filter(id => currentInventory.some(item => item.id === id));
        if (_validStorage.length !== storageList.length) { storageList = _validStorage; if (typeof TavernHelper !== 'undefined') TavernHelper.insertOrAssignVariables({ [CONFIG.varStorageKey]: storageList }, { type: 'chat' }); }
        let allStaffHeldIds = [];
        Object.values(staffItemsMap).forEach(ids => allStaffHeldIds = allStaffHeldIds.concat(ids));
        const priceHeldIds = priceSlotsData.filter(s => s.id).map(s => s.id);
        const aiVisibleInventory = currentInventory.filter(item => !storageList.includes(item.id) && !allStaffHeldIds.includes(item.id) && !priceHeldIds.includes(item.id));
        refreshSystemPrompt(aiVisibleInventory);
        refreshStaffPrompt(currentStaff, currentInventory, staffItemsMap);
        refreshPricePrompt(null, isSlotsDirty ? priceSlotsData : null);
        $('#th-inv-counter').text(`物品:${aiVisibleInventory.length}${(storageList.length + allStaffHeldIds.length + priceHeldIds.length) > 0 ? `(+${storageList.length + allStaffHeldIds.length + priceHeldIds.length})` : ''}`);
        $('#th-ach-counter').text(`成就:${currentAchievements.length}`);
    }


    // =================================================================
    // === 按需渲染：只渲染当前激活的 Tab ===
    // =================================================================
    function renderActiveTab() {
        const $panel = $('#' + CONFIG.domPanelId);
        if (!$panel.is(':visible')) return;

        if ($('#th-tab-inv').hasClass('active') && dirtyTabs.has('inventory')) {
            renderInventory();
            dirtyTabs.delete('inventory');
        } else if ($('#th-tab-price').hasClass('active') && dirtyTabs.has('price')) {
            if (priceSubView === 'shelf') renderPriceShelf();
            else renderPriceBoard();
            dirtyTabs.delete('price');
        } else if ($('#th-tab-staff').hasClass('active') && dirtyTabs.has('staff')) {
            renderStaffBoard(getVars()[CONFIG.varStaffKey] || []);
            dirtyTabs.delete('staff');
        } else if ($('#th-tab-infra').hasClass('active') && dirtyTabs.has('infra')) {
            renderInfraBoard(getVars()[CONFIG.varRenoKey] || []);
            dirtyTabs.delete('infra');
        } else if ($('#th-tab-ach').hasClass('active') && dirtyTabs.has('achievement')) {
            renderAchievements();
            dirtyTabs.delete('achievement');
        } else if ($('#th-tab-guest').hasClass('active') && dirtyTabs.has('guest')) {
            renderGuestLog(getVars()[CONFIG.varGuestLogKey] || []);
            dirtyTabs.delete('guest');
        }
    }

    function refreshSystemPrompt(inventory) {
        let listStr = inventory.length === 0 ? "(背包为空)" : "";
        inventory.forEach(item => { listStr += `ID: ${item.id} | ${item.icon} | ${item.name} | ${item.desc || '无描述'}\n`; });
        const promptContent = `
<Item_Rules>
[系统模块: 物品栏数据库]
当前{{user}}拥有的物品清单:
${listStr}

严格按照以下格式，记录本轮剧情中客观的物品获取情况(如购置的商品、食材、书信便条(在描述中附全文)、尚未分配去处的物资等)。如无变更则不必记录。
1.当{{user}}获得重要物品:
CMD:ADD | 图标 | 名称 | (选填)描述
2.当**物品清单**中的物品发生重要性质变化:
CMD:MOD | ID | 修正图标 | 修正名称 | (选填)修正描述
3.当物品清单中的物品用完、丢弃或所有权转移时:
CMD:DEL | ID
以上指令均在正文结尾输出，并以一组<Item>标签包裹所有增删改(如有)。
注意:
 - (如有)描述应始终记录物品最本质客观的属性
 - 禁止将货币计入物品
 - ID仅作为增删改格式使用，禁止出现在剧情中

 示例:
  以一罐蒜蓉酱为例，获得蒜蓉酱时:
 <Item>
 CMD:ADD | 🥫 | 蒜蓉酱 | 一罐未拆封的蒜蓉酱(250g)
 </Item>

 使用蒜蓉酱后(量发生变化，用分数表示):
 <Item>
 CMD:MOD | 001(该道具在数据库中对应ID) | 🥫 | 蒜蓉酱 | 开封蒜蓉酱(175/250g)，还剩下半罐
 </Item>

 用完蒜蓉酱时:
 <Item>
 CMD:DEL | 001
 </Item>

</Item_Rules>`;
        if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.promptId]);
        const injection = { id: CONFIG.promptId, position: 'in_chat', depth: CONFIG.inventoryDepth, role: 'system', content: promptContent, should_scan: true };
        if (typeof injectPrompts !== 'undefined') injectPrompts([injection]);
    }

    function refreshStaffPrompt(staffList, fullInventory, staffItemsMap) {
        if (staffList.length === 0) {
            if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.staffPromptId]);
            return;
        }

        const exportData = staffList.map(staff => {
            let s = { ...staff };
            let name = s['姓名'] || s['Name'] || s['name'];
            const heldIds = staffItemsMap[name] || [];

            if (heldIds.length > 0) {
                s['持有物品'] = [];
                heldIds.forEach(id => {
                    const item = fullInventory.find(i => i.id === id);
                    if (item) {
                        s['持有物品'].push(`${item.icon} ${item.name} (ID:${item.id})`);
                    }
                });
            }
            return s;
        });

        const jsonStr = JSON.stringify(exportData, null, 2);
        const promptContent = `<Employee_Profile>\n${jsonStr}\n</Employee_Profile>`;

        if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.staffPromptId]);
        const injection = { id: CONFIG.staffPromptId, position: 'in_chat', depth: CONFIG.staffDepth, role: 'system', content: promptContent, should_scan: true };
        if (typeof injectPrompts !== 'undefined') injectPrompts([injection]);
    }

    function refreshInfraPrompt(renoList) {
        if (!renoList || renoList.length === 0) {
            if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.infraPromptId]);
            return;
        }
        const recent = renoList.slice(-10).reverse();
        let lines = [];
        recent.forEach(r => {
            lines.push(`${r.date}: ${r.detail} (花费${r.cost}小判)`);
        });
        const promptContent = `\n<Tavern_Infrastructure>\n[基建修缮记录]\n${lines.join('\n')}\n</Tavern_Infrastructure>\n`;
        if (typeof uninjectPrompts !== 'undefined') uninjectPrompts([CONFIG.infraPromptId]);
        const injection = { id: CONFIG.infraPromptId, position: 'in_chat', depth: CONFIG.infraDepth, role: 'system', content: promptContent, should_scan: true };
        if (typeof injectPrompts !== 'undefined') injectPrompts([injection]);
    }

    // =================================================================
    // === 检查点（增量扫描基础）===
    // =================================================================

    function getCheckpoint() {
        try {
            if (typeof TavernHelper !== 'undefined') {
                return TavernHelper.getVariables({ type: 'chat' })[CONFIG.varCheckpointKey] || null;
            }
        } catch(e) {}
        return null;
    }

    function saveCheckpoint(snapshot) {
        try {
            if (typeof TavernHelper !== 'undefined') {
                TavernHelper.insertOrAssignVariables({ [CONFIG.varCheckpointKey]: snapshot }, { type: 'chat' });
            }
        } catch(e) { console.error('saveCheckpoint failed', e); }
    }

    /** 删楼后调用：作废检查点，强迫下次全量扫重新建立干净的快照 */
    function clearCheckpoint() {
        try {
            if (typeof TavernHelper !== 'undefined') {
                TavernHelper.insertOrAssignVariables({ [CONFIG.varCheckpointKey]: null }, { type: 'chat' });
            }
        } catch(e) { console.error('clearCheckpoint failed', e); }
    }

    /** 手动建立检查点：触发一次完整全量扫描，完成后强制保存检查点 */
    function createCheckpoint() {
        if(window.toastr) toastr.info('正在建立检查点…', '系统');
        performScan('full', true);
    }

    // =================================================================
    // === 全量变量导出 / 导入（跨存档迁移）===
    // =================================================================

    function exportAllData() {
        flushPriceSave();
        const vars = getVars();
        const exportKeys = [
            CONFIG.varDataKey, CONFIG.varMapKey, CONFIG.varMaxIdKey,
            CONFIG.varAchieveKey, CONFIG.varStorageKey, CONFIG.varGuestKey,
            CONFIG.varRenoKey, CONFIG.varPriceKey, CONFIG.varPriceSlotsKey,
            CONFIG.varStaffItemsKey, CONFIG.varStaffKey, CONFIG.varCheckpointKey,
            CONFIG.varGuestLogKey, CONFIG.varNoticeKey
        ];
        const exportObj = { version: 2, timestamp: new Date().toISOString() };
        exportKeys.forEach(k => { if (vars[k] !== undefined) exportObj[k] = vars[k]; });
        const json = JSON.stringify(exportObj, null, 2);
        const blob = new Blob([json], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `tavern_backup_${new Date().toISOString().slice(0,10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
        if(window.toastr) toastr.success('数据已导出', '系统');
    }

    function _refreshUIAfterImport() {
        const vars = getVars();
        const inv = vars[CONFIG.varDataKey] || [];
        const achievements = vars[CONFIG.varAchieveKey] || [];
        const staff = vars[CONFIG.varStaffKey] || [];
        const guests = vars[CONFIG.varGuestKey] || [];
        const renoList = vars[CONFIG.varRenoKey] || [];
        const storageList = vars[CONFIG.varStorageKey] || [];
        const staffItemsMap = vars[CONFIG.varStaffItemsKey] || {};
        const slotsData = getPriceSlotsData();
        let allStaffHeldIds = [];
        Object.values(staffItemsMap).forEach(ids => allStaffHeldIds = allStaffHeldIds.concat(ids));
        const priceHeldIds = slotsData.filter(s => s.id).map(s => s.id);
        const aiVisibleInventory = inv.filter(item => !storageList.includes(item.id) && !allStaffHeldIds.includes(item.id) && !priceHeldIds.includes(item.id));
        // 更新计数器
        const hidden = storageList.filter(id => inv.some(i => i.id === id)).length + allStaffHeldIds.length + priceHeldIds.length;
        $('#th-inv-counter').text(`物品:${aiVisibleInventory.length}${hidden > 0 ? `(+${hidden})` : ''}`);
        $('#th-ach-counter').text(`成就:${achievements.length}`);
        // 刷新所有 Prompt
        refreshSystemPrompt(aiVisibleInventory);
        refreshStaffPrompt(staff, inv, staffItemsMap);
        refreshPricePrompt();
        refreshGuestPrompt(guests, getVars()[CONFIG.varGuestLogKey] || []);
        refreshInfraPrompt(renoList);
        // 保存导入基准检查点，防止后续 performScan 用空聊天记录覆盖数据
        try {
            let _lastMsgId = 0;
            if (typeof getChatMessages !== 'undefined') {
                const _msgs = getChatMessages('0-{{lastMessageId}}');
                if (_msgs && _msgs.length > 0) _lastMsgId = _msgs[_msgs.length - 1].message_id;
            }
            const _dbMap = vars[CONFIG.varMapKey] || {};
            Object.keys(_dbMap).forEach(k => {});  // ensure object
            // 重建 activeGuestBook
            const _guestBook = {};
            (guests || []).forEach(g => { const gid = getGuestGroupID(g); if (gid) _guestBook[gid] = g; });
            // 独立存储导入基准，clearCheckpoint() 不会影响这个变量
            const _importBase = {
                maxId: vars[CONFIG.varMaxIdKey] || 0,
                dbMap: _dbMap,
                inventory: inv,
                achievements: achievements,
                staff: staff,
                activeGuestBook: _guestBook,
                renovationList: renoList
            };
            TavernHelper.insertOrAssignVariables({ [CONFIG.varImportBaseKey]: _importBase }, { type: 'chat' });
            // 同时把检查点指向当前楼层，让 generation_started 走增量扫描
            saveCheckpoint({ message_id: _lastMsgId, maxId: _importBase.maxId, dbMap: _dbMap, inventory: inv, achievements: achievements, staff: staff, activeGuestBook: _guestBook, renovationList: renoList, worldDate: '' });
        } catch(e) { console.error('import checkpoint save failed', e); }
        // 标脏所有 Tab，切换时重新渲染
        ['inventory', 'staff', 'achievement', 'price', 'infra', 'guest'].forEach(t => dirtyTabs.add(t));
        if (isPanelOpen) renderActiveTab();
        if (isStorageOpen) renderStorageItems();
    }

    function importAllData() {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = '.json,application/json';
        input.onchange = function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(evt) {
                try {
                    const obj = JSON.parse(evt.target.result);
                    if (!obj.version) { alert('文件格式不正确，无法导入。'); return; }
                    if (!confirm('导入后当前存档的所有物品/成就/员工数据将被覆盖，确定吗？')) return;
                    const toImport = { ...obj };
                    delete toImport.version;
                    delete toImport.timestamp;
                    if (typeof TavernHelper !== 'undefined') {
                        TavernHelper.insertOrAssignVariables(toImport, { type: 'chat' });
                    }
                    if(window.toastr) toastr.success('数据已导入，正在刷新…', '系统');
                    // 导入后直接从变量渲染，禁止 performScan（会用空聊天记录覆盖刚导入的数据）
                    _refreshUIAfterImport();
                } catch(err) { alert('读取文件失败：' + err.message); }
            };
            reader.readAsText(file, 'utf-8');
        };
        document.body.appendChild(input);
        input.click();
        document.body.removeChild(input);
    }

    function scheduleScan(mode) {
        if (debounceTimer) clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => performScan(mode || 'full'), CONFIG.debounceDelay);
    }

