    function smartParse(rawStr) {
        if (!rawStr) return [];
        let str = rawStr.replace(/<[^>]+>/g, '').trim();
        str = str.replace(/[（）]/g, m => m === '（' ? '(' : ')');
        if (str.startsWith('|') || str.startsWith('｜') || str.startsWith('/')) str = str.substring(1);
        if (str.endsWith('|') || str.endsWith('｜') || str.endsWith('/')) str = str.substring(0, str.length - 1);
        const separator = str.includes('|') ? '|' : (str.includes('｜') ? '｜' : '/');
        const parts = str.split(separator);
        return parts.map(p => { let s = p.trim(); if (s.startsWith('(') && s.endsWith(')')) s = s.substring(1, s.length - 1).trim(); return s; }).filter(p => p !== "");
    }

    function getEventPos(e) {
        const evt = e.originalEvent || e;
        if (evt.touches && evt.touches.length > 0) {
            return { x: evt.touches[0].clientX, y: evt.touches[0].clientY };
        }
        if (evt.changedTouches && evt.changedTouches.length > 0) {
            return { x: evt.changedTouches[0].clientX, y: evt.changedTouches[0].clientY };
        }
        return { x: evt.clientX, y: evt.clientY };
    }

    function updateUIScale(newScale) {
        if (newScale) {
            uiScale = parseFloat(newScale.toFixed(1));
            if (uiScale < 0.5) uiScale = 0.5;
            if (uiScale > 2.0) uiScale = 2.0;
            localStorage.setItem(CONFIG.scaleKey, uiScale);
