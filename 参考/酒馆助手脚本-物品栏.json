            let slotsHtml = '';
            for(let i=0; i<2; i++) {
                const itemId = heldIds[i];
                let content = '';
                let filledClass = '';
                if (itemId) {
                    const item = fullInventory.find(it => it.id === itemId);
                    if (item) {
                        content = `<div class="th-staff-slot-icon">${item.icon}</div>`;
