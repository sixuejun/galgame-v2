    function renderInfraBoard(renoList) {
        const $list = $('#th-list-infra');
        $list.empty();

        if (!renoList || renoList.length === 0) {
            $list.html('<div style="text-align:center; color:#888; margin-top:20px;">暂无基建记录<br><span style="font-size:10px">通过万事屋管家进行修缮后会自动记录</span></div>');
            return;
        }

        const reversedList = [...renoList].reverse();

        reversedList.forEach(item => {
            let detailHtml = '';
            const regexItem = /([^、,，]+?)\s*[（(]花费(\d+)小判进行([\s\S]*?)[)）](?:[、,，]|$)/g;
            let match;
            let hasMatch = false;

            while ((match = regexItem.exec(item.detail)) !== null) {
                hasMatch = true;
                const areaName = match[1].trim();
                const cost = parseInt(match[2]);
                const actionDesc = match[3].trim();

                let icon = '🔧';
                let tierClass = '';
                if (cost <= 100) { icon = '🧹'; tierClass = 'tier-100'; }
                else if (cost <= 1000) { icon = '🔨'; tierClass = 'tier-1000'; }
                else { icon = '🏗️'; tierClass = 'tier-5000'; }

                detailHtml += `
                    <div class="th-infra-item ${tierClass}">
                        <div class="th-infra-icon">${icon}</div>
                        <div class="th-infra-text">
                            <span class="th-infra-area">${areaName}</span>
                            ${actionDesc ? `<span style="opacity:0.8; font-size:11px;">- ${actionDesc}</span>` : ''}
                        </div>
                    </div>
                `;
            }

            if (!hasMatch) {
                detailHtml = `<div style="font-size:11px; color:#666; padding:5px;">${item.detail}</div>`;
            }

            const card = $(`
                <div class="th-infra-card">
                    <div class="th-infra-header">
                        <span class="th-infra-date">📅 ${item.date}</span>
                        <span class="th-infra-cost">-${item.cost} G</span>
                    </div>
                    <div class="th-infra-body">
                        ${detailHtml}
                    </div>
                </div>
            `);
            $list.append(card);
        });

        parseEmoji($list[0]);
    }

