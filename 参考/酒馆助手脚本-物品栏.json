    /** 将当前价目表导出为 JSON 文件 */
    function exportPriceData() {
        flushPriceSave();
        const listData = getPriceData();
        const slotsData = getPriceSlotsData();
        const exportObj = { version: 1, priceList: listData, priceSlots: slotsData };
        const json = JSON.stringify(exportObj, null, 2);
        const blob = new Blob([json], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'price_board.json';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
    }

    /** 从 JSON 文件导入价目表并覆盖当前数据 */
    function importPriceData() {
        const input = document.createElement('input');
        input.type = 'file';
        input.accept = '.json,application/json';
        input.onchange = function(e) {
            const file = e.target.files[0];
            if (!file) return;
            const reader = new FileReader();
            reader.onload = function(evt) {
                try {
                    const obj = JSON.parse(evt.target.result);
                    let listData = null, slotsData = null;
                    if (obj.version === 1 && Array.isArray(obj.priceList)) {
                        listData = obj.priceList;
                        slotsData = obj.priceSlots || null;
                    } else if (Array.isArray(obj)) {
                        // 兼容直接存 priceList 数组的旧格式
                        listData = obj;
                    } else {
                        alert('价目表文件格式不正确，无法导入。');
                        return;
                    }
                    if (typeof TavernHelper !== 'undefined') {
                        const toSave = { [CONFIG.varPriceKey]: listData };
                        if (slotsData) toSave[CONFIG.varPriceSlotsKey] = slotsData;
                        TavernHelper.insertOrAssignVariables(toSave, { type: 'chat' });
                    }
                    renderPriceBoard();
                } catch(err) {
                    alert('读取文件失败：' + err.message);
                }
            };
            reader.readAsText(file, 'utf-8');
        };
        document.body.appendChild(input);
        input.click();
        document.body.removeChild(input);
    }

