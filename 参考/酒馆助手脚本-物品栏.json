    // 【新增】来访者信息解析函数
        function parseGuestData(content) {
    const results = [];

    // 第一层：提取所有 <Guest_Info> 块
    const blockRegex = /<Guest_Info>([\s\S]*?)<\/Guest_Info>/gi;
    let blockMatch;

    while ((blockMatch = blockRegex.exec(content)) !== null) {
        const blockContent = blockMatch[1];

        // 第二层：按"住宿日期:"切割，每次出现就是一个新来访者
        // 用 lookahead 保留"住宿日期:"在每段开头
        const chunks = blockContent.split(/(?=\r?\n(?:住宿|停留)日期[:：])/);

        chunks.forEach(chunk => {
            chunk = chunk.trim();
            if (!chunk || !chunk.match(/(?:住宿|停留)日期[:：]/)) return;

            const dateMatch = chunk.match(/(?:住宿|停留)日期[:：]\s*(.*?)\s*~\s*(.*?)(?:\r?\n|$)/);
            if (!dateMatch) return;

            const purposeMatch = chunk.match(/(?:团队|来访)目的[:：]\s*(.*?)(?:\r?\n|$)/);
            // 重要角色：抓到"其它/他角色"出现之前，或段落结尾
            const rolesMatch = chunk.match(/重要角色.*?[:：]([\s\S]*?)(?=\r?\n其[它他]角色|$)/);
            // 其它角色：从标签后到段落结尾
            const othersMatch = chunk.match(/其[它他]角色.*?[:：]\s*([\s\S]*?)$/);

            const rolesList = [];
            const rawRoles = rolesMatch ? rolesMatch[1] : "";
            if (rawRoles) {
                const blocks = rawRoles.match(/【[\s\S]*?】/g) || [];
                blocks.forEach(b => {
                    var r = {};
                    b.replace(/[【】]/g, "").split(/[|｜]/).forEach(p => {
                        var arr = p.split(/[:：]/);
                        if (arr.length >= 2) r[arr[0].trim()] = arr.slice(1).join(':').trim();
                    });
                    r['room'] = "";
                    rolesList.push(r);
                });
            }

            results.push({
                date_range: dateMatch[1].trim() + " ~ " + dateMatch[2].trim(),
                purpose: purposeMatch ? purposeMatch[1].trim() : "",
                roles: rolesList,
                others: othersMatch && othersMatch[1].trim() && othersMatch[1].trim() !== '无' ? othersMatch[1].trim() : "",
                others_room: "",
                pending_payment: "",
                note: ""
            });
        });
    }

    return results; // 始终返回数组
}

// 【新增】生成来访者团体的唯一ID（防重复/防覆盖关键）
    function getGuestGroupID(data) {
        // 逻辑：用 "住宿日期 + 领头人姓名" 作为唯一标识
        // 如果没有角色信息，就用 "住宿日期 + 目的"
        let keyPart = "Unknown";
        if (data.roles && data.roles.length > 0) {
            // 尝试获取角色列表里第一个人的姓名
            keyPart = data.roles[0]['姓名'] || data.roles[0]['Name'] || '未知';
        } else {
            keyPart = data.purpose.substring(0, 10); // 取目的的前10个字
        }
        // 生成 ID，例如: "霜降1日~2日_萨尔瓦托雷"
        return `${data.date_range}_${keyPart}`;
    }


