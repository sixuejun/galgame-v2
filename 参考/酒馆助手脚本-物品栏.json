        const ballEl = $ball[0];
        let touchDragging = false;
        let mouseDragging = false, isMouseDown = false;
        let startX, startY, initL, initT;

        // ===== 触控拖动（手机端，原有逻辑不变）=====
        $ball.on('touchstart', e => {
            touchDragging = false;
            const t = e.touches[0];
            startX = t.clientX; startY = t.clientY;
            const r = ballEl.getBoundingClientRect();
            initL = r.left; initT = r.top;
        });
        $ball.on('touchmove', e => {
            const t = e.touches[0];
            const moveX = t.clientX - startX, moveY = t.clientY - startY;
            if (Math.abs(moveX) > 10 || Math.abs(moveY) > 10) {
                touchDragging = true;
                $ball.css({ left: initL + moveX + 'px', top: initT + moveY + 'px', transform: 'none' });
            }
            e.preventDefault();
        });
        $ball.on('touchend', () => {
            if (!touchDragging) togglePanel();
            touchDragging = false;
        });

        // ===== 鼠标拖动（电脑端）=====
        ballEl.addEventListener('pointerdown', e => {
            if (e.pointerType !== 'mouse' || e.button !== 0) return;
            isMouseDown = true;
            mouseDragging = false;
            startX = e.clientX; startY = e.clientY;
            const r = ballEl.getBoundingClientRect();
            initL = r.left; initT = r.top;
            try { ballEl.setPointerCapture(e.pointerId); } catch(err) {}
            e.preventDefault();
        });
        ballEl.addEventListener('pointermove', e => {
            if (e.pointerType !== 'mouse' || !isMouseDown) return;
            const moveX = e.clientX - startX, moveY = e.clientY - startY;
            if (!mouseDragging && (Math.abs(moveX) > 5 || Math.abs(moveY) > 5)) {
                mouseDragging = true;
                ballEl.style.cursor = 'grabbing';
            }
            if (mouseDragging) {
                ballEl.style.left = (initL + moveX) + 'px';
                ballEl.style.top  = (initT + moveY) + 'px';
                ballEl.style.transform = 'none';
            }
        });
        ballEl.addEventListener('pointerup', e => {
            if (e.pointerType !== 'mouse') return;
            if (!mouseDragging) togglePanel();
            isMouseDown = false;
            mouseDragging = false;
            ballEl.style.cursor = 'pointer';
        });
        ballEl.addEventListener('pointercancel', e => {
            if (e.pointerType !== 'mouse') return;
            isMouseDown = false;
            mouseDragging = false;
        });
    }

    // 【修改】拖拽逻辑增加对价目槽的支持
    function bindDragEvents($el, item, sourceType, staffName = null) {
        let isDragging = false;
        let dragTimer = null;
        let startX, startY;
        let $helper = null;

        // ── 共用：根据当前坐标更新高亮 ──
        function updateHighlight(cx, cy) {
            const $storagePopup = $('#' + CONFIG.domStorageId);
            const $mainPanel = $('#' + CONFIG.domPanelId);
            const $binIcon = $('#th-storage-bin');
            const pos = { clientX: cx, clientY: cy };

            $('.th-staff-slot').removeClass('th-drop-target-active');
            $('.th-price-slot').removeClass('th-drop-target-active');
            $storagePopup.removeClass('th-drop-target-active');
            $binIcon.removeClass('th-inv-storage-bin-active');

            if (sourceType === 'from_main' || sourceType === 'from_staff' || sourceType === 'from_price') {
                if ($binIcon.length && $binIcon.is(':visible') && isIntersecting(pos, $binIcon[0])) {
                    $binIcon.addClass('th-inv-storage-bin-active');
                }
            }
            if ($mainPanel.is(':visible')) {
                if ($('#th-list-staff').is(':visible')) {
                    $('.th-staff-slot:not(.filled)').each(function() {
                        if (isIntersecting(pos, this)) $(this).addClass('th-drop-target-active');
                    });
                }
                if ($('#th-list-price').is(':visible')) {
                    $('#th-shelf-slots-inner').find('.th-shelf-box').each(function() {
                        if (isIntersecting(pos, this)) {
                            const rect = this.getBoundingClientRect();
                            const isRight = (pos.clientX - rect.left) > rect.width / 2;
                            const boxes = $('#th-shelf-slots-inner').find('.th-shelf-box');
                            const boxIdx = boxes.index(this);
                            const slotIdx = boxIdx * 2 + (isRight ? 1 : 0);
                            $(`.th-price-slot[data-slot-index="${slotIdx}"]`).not('.filled').addClass('th-drop-target-active');
                        }
                    });
                }
            }
        }

        // ── 共用：松手时判断落点并执行操作 ──
        function handleDrop(cx, cy) {
            const pos = { clientX: cx, clientY: cy };
            let handled = false;

            if (sourceType === 'from_main') {
                const $popup = $('#' + CONFIG.domStorageId);
                const $bin = $('#th-storage-bin');
                if (($popup.is(':visible') && isIntersecting(pos, $popup[0])) ||
                    ($bin.is(':visible') && isIntersecting(pos, $bin[0]))) {
                    moveToStorage(item.id); handled = true;
                }
            } else if (sourceType === 'from_staff') {
                const $popup = $('#' + CONFIG.domStorageId);
                if ($popup.is(':visible') && isIntersecting(pos, $popup[0])) {
                    moveStaffToStorage(item.id, staffName); handled = true;
                }
            }

            if (!handled) {
                if ($('#th-list-staff').is(':visible')) {
                    $('.th-staff-slot:not(.filled)').each(function() {
                        if (isIntersecting(pos, this)) {
                            const sName = $(this).data('staff');
                            if (sourceType === 'from_storage') moveStorageToStaff(item.id, sName);
                            return false;
                        }
                    });
                }
                if ($('#th-list-price').is(':visible')) {
                    $('#th-shelf-slots-inner').find('.th-shelf-box').each(function() {
                        if (!handled && isIntersecting(pos, this)) {
                            const rect = this.getBoundingClientRect();
                            const isRight = (pos.clientX - rect.left) > rect.width / 2;
                            const boxes = $('#th-shelf-slots-inner').find('.th-shelf-box');
                            const boxIdx = boxes.index(this);
                            const slotIdx = boxIdx * 2 + (isRight ? 1 : 0);
                            const $slot = $(`.th-price-slot[data-slot-index="${slotIdx}"]`).not('.filled');
                            if ($slot.length) {
                                // from_price 时 staffName 存的是来源槽索引，透传以便清除旧槽
                                const srcSlot = (sourceType === 'from_price') ? staffName : null;
                                moveItemToPriceSlot(item.id, slotIdx, srcSlot);
                                handled = true;
                            }
                        }
                    });
                }
            }
            if (!handled && sourceType === 'from_price') {
                const $storageEl = $('#' + CONFIG.domStorageId);
                if ($storageEl.is(':visible') && isIntersecting(pos, $storageEl[0])) {
                    removeItemFromPriceSlot(staffName); handled = true;
                }
            }
            if (!handled && sourceType === 'from_storage') {
                const $panel = $('#' + CONFIG.domPanelId);
                if ($panel.is(':visible') && isIntersecting(pos, $panel[0])) {
                    retrieveFromStorage(item.id);
                }
            }
        }

        // ── 共用：拖拽结束清理 ──
        function endDrag() {
            $el.css('opacity', '1');
            if ($helper) { $helper.remove(); $helper = null; }
            $('#' + CONFIG.domStorageId).removeClass('th-drop-target-active');
            $('#th-storage-bin').removeClass('th-inv-storage-bin-active');
            $('.th-staff-slot').removeClass('th-drop-target-active');
            $('.th-price-slot').removeClass('th-drop-target-active');
            isDragging = false;
        }

        // ── 触控拖拽（手机端，长按200ms触发）──
        $el.on('touchstart', (e) => {
            if(e.touches.length > 1) return;
            $('.th-drag-helper').remove();
            const t = e.touches[0];
            startX = t.clientX; startY = t.clientY;
            dragTimer = setTimeout(() => {
                isDragging = true;
                $helper = $el.clone().addClass('th-drag-helper').appendTo('body');
                $helper.css({ left: startX - 25, top: startY - 25 });
                $el.css('opacity', '0.4');
                if (sourceType === 'from_main' && !isStorageOpen) toggleStoragePopup();
                if (sourceType === 'from_staff' && !isStorageOpen) toggleStoragePopup();
                if (sourceType === 'from_price' && !isStorageOpen) toggleStoragePopup();
            }, 200);
        });

        $el.on('touchmove', (e) => {
            if (!isDragging) { if (dragTimer) { clearTimeout(dragTimer); dragTimer = null; } return; }
            e.preventDefault();
            const t = e.touches[0];
            $helper.css({ left: t.clientX - 25, top: t.clientY - 25 });
            updateHighlight(t.clientX, t.clientY);
        });

        $el.on('touchend touchcancel', (e) => {
            if (dragTimer) clearTimeout(dragTimer);
            if (isDragging) {
                if (e.type === 'touchend') {
                    const t = e.changedTouches[0];
                    handleDrop(t.clientX, t.clientY);
                }
                endDrag();
            }
        });

        // ── 鼠标拖拽（电脑端，直接按住拖动）──
        const el = $el[0];
        let isMouseDown = false, mouseDragging = false;

        el.addEventListener('pointerdown', (e) => {
            if (e.pointerType !== 'mouse' || e.button !== 0) return;
            isMouseDown = true; mouseDragging = false;
            startX = e.clientX; startY = e.clientY;
            try { el.setPointerCapture(e.pointerId); } catch(err) {}
            e.preventDefault();
        });

        el.addEventListener('pointermove', (e) => {
            if (e.pointerType !== 'mouse' || !isMouseDown) return;
            const moveX = e.clientX - startX, moveY = e.clientY - startY;
            if (!mouseDragging && (Math.abs(moveX) > 5 || Math.abs(moveY) > 5)) {
                mouseDragging = true;
                isDragging = true;
                $('.th-drag-helper').remove();
                $helper = $el.clone().addClass('th-drag-helper').appendTo('body');
                $helper.css({ left: e.clientX - 25, top: e.clientY - 25 });
                $el.css('opacity', '0.4');
                if (sourceType === 'from_main' && !isStorageOpen) toggleStoragePopup();
                if (sourceType === 'from_staff' && !isStorageOpen) toggleStoragePopup();
                if (sourceType === 'from_price' && !isStorageOpen) toggleStoragePopup();
            }
            if (mouseDragging) {
                $helper.css({ left: e.clientX - 25, top: e.clientY - 25 });
                updateHighlight(e.clientX, e.clientY);
            }
        });

        el.addEventListener('pointerup', (e) => {
            if (e.pointerType !== 'mouse') return;
            if (mouseDragging) {
                handleDrop(e.clientX, e.clientY);
                endDrag();
            }
            isMouseDown = false; mouseDragging = false;
        });

        el.addEventListener('pointercancel', (e) => {
            if (e.pointerType !== 'mouse') return;
            if (mouseDragging) endDrag();
            isMouseDown = false; mouseDragging = false;
        });
    }

    function isIntersecting(touch, element) {
        const r = element.getBoundingClientRect();
        return touch.clientX >= r.left && touch.clientX <= r.right &&
               touch.clientY >= r.top && touch.clientY <= r.bottom;
    }

    // --- 初始化入口 ---
    function init() {
        if (initRetryCount > 20) {
            if(window.toastr) toastr.warning("脚本依赖项加载超时，部分功能可能不可用");
            return;
        }

        const hasJQuery = !!window.$;
        const hasMsgGetter = (typeof getChatMessages !== 'undefined') || (typeof TavernHelper !== 'undefined');

        if (!hasJQuery || !hasMsgGetter) {
            initRetryCount++;
            setTimeout(init, 250);
            return;
        }

        try {
            $('[id^="th-inventory"]').remove();
            $('[id^="th-fixed"]').remove();
            $('#th-detail-popup-ui').remove();
            $('.th-drag-helper').remove();

            loadTwemoji();
            loadGoogleFonts();

            if (typeof appendInexistentScriptButtons !== 'undefined') {
                appendInexistentScriptButtons([
                    { name: CONFIG.toggleButtonName, visible: true }
                ]);
            }

            createUI();

            // 监听 iframe 卸载事件，切换角色卡时自动清除残留的 DOM 元素
            window.addEventListener('unload', function() {
                $('[id^="th-fixed"]').remove();
                $('#' + CONFIG.domBallId).remove();
                $('#th-detail-popup-ui').remove();
                $('.th-drag-helper').remove();
            });

            bindEvents();
            performScan();
            refreshPricePrompt();
            updateUIScale();
            applyNightMode();

            //if(window.toastr) toastr.success('物品栏就绪', '系统');

        } catch (e) {
            alert("脚本错误:\n" + e.message);
            console.error(e);
        }
    }

    $(document).ready(init);
})();
