    function getPriceData() {
        const data = getVars()[CONFIG.varPriceKey];
        if (!Array.isArray(data) || data.length === 0) {
            return [ { name: "", price: "" }, { name: "", price: "" }, { name: "", price: "" }, { name: "", price: "" }, { note: "" } ];
        }
        const last = data[data.length - 1];
        if (!last || typeof last.note === 'undefined') {
            data.push({ note: "" });
        }
        return data;
    }

    function getPriceSlotsData() {
        const data = getVars()[CONFIG.varPriceSlotsKey];
        if (!Array.isArray(data) || data.length < 6) {
            return [ { id: null, price: "" }, { id: null, price: "" }, { id: null, price: "" }, { id: null, price: "" }, { id: null, price: "" }, { id: null, price: "" } ];
        }
        return data;
    }

    function savePriceData() {
        // 价目板行数据：只有在价目板视图时才从 DOM 读，否则从变量读（防止切换子视图时丢数据）
        let newData;
        if (priceSubView === 'board' && $('#th-list-price .th-price-row.normal').length > 0) {
            newData = [];
            $('#th-list-price .th-price-row.normal').each(function() {
                const name = $(this).find('.name-input').val().trim();
                const price = $(this).find('.price-input').val().trim();
                if (name || price) newData.push({ name, price });
            });
            const note = $('#th-list-price .th-price-row.special .note-input').val().trim();
            newData.push({ note });
        } else {
            // 货架视图或面板关闭时，直接用变量里的旧值，不覆盖
            newData = getPriceData();
        }

        // 槽位定价：只有在货架视图时才从 DOM 读
        const slotsData = getPriceSlotsData();
        if (priceSubView === 'shelf') {
            $('#th-shelf-slots-inner .th-price-slot-input').each(function(index) {
                const val = $(this).val().trim();
                if (slotsData[index]) slotsData[index].price = val;
            });
        }

        if (typeof TavernHelper !== 'undefined') {
            TavernHelper.insertOrAssignVariables({
                [CONFIG.varPriceKey]: newData,
                [CONFIG.varPriceSlotsKey]: slotsData
            }, { type: 'chat' });
        }
        refreshPricePrompt(newData, slotsData);
    }

    /** 如果有未保存的价目数据，立即同步保存（防止 re-render 丢失编辑） */
    function flushPriceSave() {
        if (priceSaveTimer) {
            clearTimeout(priceSaveTimer);
            priceSaveTimer = null;
            savePriceData();
        }
